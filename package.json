{
  "name": "pxlblz-ide",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check:node": "node scripts/check-node-version.mjs",
    "dev": "vite",
    "build": "npm run check:node && tsc -b && vite build",
    "check:playwright": "node scripts/check-playwright-browser.mjs",
    "preview": "vite preview",
    "cf:build": "VITE_BASE_PATH=/ npm run build",
    "cf:dev": "wrangler pages dev dist",
    "cf:dev:local": "wrangler pages dev dist --port 8788",
    "cf:session": "tsx scripts/local-session-cookie.ts",
    "db:create": "wrangler d1 create pxlblz-ide",
    "db:migrate:local": "wrangler d1 migrations apply pxlblz-ide --local",
    "db:migrate:remote": "wrangler d1 migrations apply pxlblz-ide --remote",
    "lint": "npm run check:node && eslint src",
    "test": "npm run check:node && vitest run",
    "test:watch": "npm run check:node && vitest",
    "test:e2e": "npm run check:node && playwright test",
    "test:e2e:auth-smoke": "npm run build && npm run db:migrate:local && playwright test e2e/authenticated-smoke.auth.spec.ts --config=playwright.auth.config.ts",
    "test:e2e:shows": "npm run build && npm run db:migrate:local && playwright test e2e/shows.auth.spec.ts --config=playwright.auth.config.ts",
    "pack:extension": "node scripts/pack-extension.mjs",
    "harness": "tsx test/divergence-harness/harness.ts",
    "profile": "tsx test/perf-harness/profiler.ts",
    "issue314": "tsx test/perf-harness/issue314.ts",
    "issue317": "tsx test/perf-harness/issue316.ts",
    "issue316": "tsx test/perf-harness/issue316.ts",
    "issue332": "tsx test/perf-harness/issue316.ts",
    "issue400": "tsx test/perf-harness/issue400.ts",
    "issue401": "tsx test/perf-harness/issue316.ts",
    "issue409": "tsx test/perf-harness/issue409.ts",
    "issue410": "tsx test/perf-harness/issue410.ts",
    "issue412": "tsx test/perf-harness/issue412.ts",
    "issue401:seed": "tsx scripts/seed-pattern-prism.ts",
    "issue402": "tsx test/perf-harness/issue316.ts",
    "issue402:seed": "tsx scripts/seed-scene-splice.ts",
    "bench": "tsx test/perf-harness/bench.ts",
    "drift": "tsx test/perf-harness/drift.ts",
    "devbench": "tsx test/perf-harness/devbench.ts",
    "spike": "tsx test/capability-spike/spike.ts",
    "prepare": "husky"
  },
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jon-whiteroomsoftware/PXLBLZ-IDE.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/jon-whiteroomsoftware/PXLBLZ-IDE/issues"
  },
  "homepage": "https://github.com/jon-whiteroomsoftware/PXLBLZ-IDE#readme",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.7",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.14",
    "vitest": "^4.1.7",
    "wrangler": "^4.106.0",
    "ws": "^8.21.0"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@monaco-editor/react": "^4.7.0",
    "@types/acorn": "^4.0.6",
    "acorn": "^8.16.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "lz-string": "^1.5.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "shadcn": "^4.8.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.13"
  }
}
