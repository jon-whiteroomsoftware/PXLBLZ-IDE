    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=convertible name=\"Convertible\" hash=b42d717b stamped=2026-09-16T00:00:00.000Z\n// pxlblz:transforms show\n// pxlblz:compat portability=adaptive dimensions=2 classes=surface resolution=adaptive exact=false\n// pxlblz:show-output version=1 kind=portable-2d dimensions=2 classes=surface resolution=variable\n/*\n * Compiled PXLBLZ Show: Convertible\n * By: PXLBLZ <pxlblz@whiteroomsoftware.com>\n *\n * Source Patterns:\n * - TestPattern1D [stock:TestPattern1D]\n *   Pattern author metadata was not recorded for these sources.\n *   If original comments are stripped later, this exported Show cannot recover missing author names.\n *\n * Preferred map: none recorded.\n * Compatibility: adaptive 2D surface maps at adaptive resolution; other compatible maps may change the composition.\n * Output contract: Portable 2D · variable resolution · compatible surface maps\n * Layout schedule:\n * - 0.0: Full (1000 ms) [start 0 ms]\n * Clip schedule:\n * - 0.0: TestPattern1D (1000 ms) [clip] [start 0 ms]\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_F = array(2000)\nvar __pxlblz_G = array(2000)\nvar __pxlblz_H = array(2000)\nvar __pxlblz_d = 0\nvar __pxlblz_i = 0\nvar __pxlblz_j = pixelCount\nvar __pxlblz_f = 1\nvar __pxlblz_t = 0\nvar __pxlblz_g = 1\nvar __pxlblz_s = 0\nvar __pxlblz_c = 0\nvar __pxlblz_b = 0\nvar __pxlblz_a = 0\nfunction __pxlblz_C() { __pxlblz_c = 0; __pxlblz_b = 0; __pxlblz_a = 0 }\nfunction __pxlblz_x(r, g, b) { __pxlblz_c = r; __pxlblz_b = g; __pxlblz_a = b }\nfunction __pxlblz_u(delta) {\n  var scaledDelta = delta * __pxlblz_g\n  __pxlblz_i = __pxlblz_i + scaledDelta\n\n  __pxlblz_v(scaledDelta)\n  \n}\nfunction __pxlblz_D() { rgb(__pxlblz_c, __pxlblz_b, __pxlblz_a) }\n\nvar __pxlblz_h=0; function __pxlblz_v(delta){__pxlblz_h+=delta} function __pxlblz_w(index,x,y){__pxlblz_x(x,__pxlblz_h/2000,y/2)}\n\nvar __pxlblz_p = 0\n\nvar __pxlblz_o = 0\n\nvar __pxlblz_k = 0\nexport function beforeRender(delta) {\n  __pxlblz_d = (__pxlblz_d + delta / 1000) % 1\n  __pxlblz_o = 0\n\n  if (__pxlblz_d < 1) {\n    __pxlblz_p = 0\n    __pxlblz_I = -1\n    __pxlblz_E = 0\n     __pxlblz_j = max(1, floor(pixelCount / 1))\n    __pxlblz_f = 1\n    __pxlblz_g = 1\n    __pxlblz_u(delta)\n  }\n  __pxlblz_k = ceil(sqrt(pixelCount))\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_p == 0) {\n    if (__pxlblz_o == 0) {\n      var __pxlblz_y = 0\n      var __pxlblz_A = clamp(x, 0, 1)\n      var __pxlblz_B = clamp(y, 0, 1)\n      if (__pxlblz_y == 0) {\n        var __pxlblz_e = __pxlblz_k\n        var __pxlblz_q = __pxlblz_A\n        var __pxlblz_r = __pxlblz_B\n        var __pxlblz_z = min(pixelCount - 1, floor(__pxlblz_r * __pxlblz_e) * __pxlblz_e + floor(__pxlblz_q * __pxlblz_e))\n        var __pxlblz_n\n        var __pxlblz_m\n        var __pxlblz_l\n        __pxlblz_f = 1\n        __pxlblz_t = 0\n        __pxlblz_s = 0\n        __pxlblz_j = pixelCount\n        __pxlblz_w(__pxlblz_z, __pxlblz_q, __pxlblz_r)\n        __pxlblz_n = __pxlblz_c\n        __pxlblz_m = __pxlblz_b\n        __pxlblz_l = __pxlblz_a\n        rgb(__pxlblz_n, __pxlblz_m, __pxlblz_l)\n        return\n      }\n    }\n  }\n  rgb(0, 0, 0)\n}\n\n"
