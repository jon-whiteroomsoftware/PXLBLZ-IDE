    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=convertible name=\"Convertible\" hash=4cac1467 stamped=2026-09-16T00:00:00.000Z\n// pxlblz:transforms show\n// pxlblz:compat portability=adaptive dimensions=2 classes=surface resolution=adaptive exact=false\n// pxlblz:show-output version=1 kind=portable-2d dimensions=2 classes=surface resolution=variable\n/*\n * Compiled PXLBLZ Show: Convertible\n * By: PXLBLZ <pxlblz@whiteroomsoftware.com>\n *\n * Source Patterns:\n * - TestPattern1D [stock:TestPattern1D]\n *   Pattern author metadata was not recorded for these sources.\n *   If original comments are stripped later, this exported Show cannot recover missing author names.\n *\n * Preferred map: none recorded.\n * Compatibility: adaptive 2D surface maps at adaptive resolution; other compatible maps may change the composition.\n * Output contract: Portable 2D · variable resolution · compatible surface maps\n * Layout schedule:\n * - 0.0: Full (1000 ms) [start 0 ms]\n * Clip schedule:\n * - 0.0: TestPattern1D (1000 ms) [clip] [start 0 ms]\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_H = array(2000)\nvar __pxlblz_I = array(2000)\nvar __pxlblz_J = array(2000)\nvar __pxlblz_c = 0\nvar __pxlblz_a = 0\nvar __pxlblz_k = 0\nvar __pxlblz_l = pixelCount\nvar __pxlblz_h = 1\nvar __pxlblz_v = 0\nvar __pxlblz_i = 1\nvar __pxlblz_u = 0\nvar __pxlblz_f = 0\nvar __pxlblz_e = 0\nvar __pxlblz_d = 0\nfunction __pxlblz_E() { __pxlblz_f = 0; __pxlblz_e = 0; __pxlblz_d = 0 }\nfunction __pxlblz_z(r, g, b) { __pxlblz_f = r; __pxlblz_e = g; __pxlblz_d = b }\nfunction __pxlblz_w(delta) {\n  var scaledDelta = delta * __pxlblz_i\n  __pxlblz_k = __pxlblz_k + scaledDelta / 1000\n  __pxlblz_x(scaledDelta)\n  \n}\nfunction __pxlblz_F() { rgb(__pxlblz_f, __pxlblz_e, __pxlblz_d) }\n\nvar __pxlblz_j=0; function __pxlblz_x(delta){__pxlblz_j+=delta} function __pxlblz_y(index,x,y){__pxlblz_z(x,__pxlblz_j/2000,y/2)}\n\nvar __pxlblz_r = 0\n\nvar __pxlblz_q = 0\n\nvar __pxlblz_m = 0\nexport function beforeRender(delta) {\n  var __pxlblz_b = floor(__pxlblz_c - __pxlblz_a / 1000 + 0.5)\n  __pxlblz_a = __pxlblz_a + delta\n  while (__pxlblz_a >= 1000) {\n    __pxlblz_a = __pxlblz_a - 1000\n    __pxlblz_b = __pxlblz_b + 1\n  }\n  while (__pxlblz_b >= 1) {\n    __pxlblz_b = __pxlblz_b - 1\n  }\n  __pxlblz_c = __pxlblz_b + __pxlblz_a / 1000\n  if (__pxlblz_c >= 1) __pxlblz_c = 1 - 0.0000152587890625\n  __pxlblz_q = 0\n\n  if (__pxlblz_c < 1) {\n    __pxlblz_r = 0\n    __pxlblz_K = -1\n    __pxlblz_G = 0\n     __pxlblz_l = max(1, floor(pixelCount / 1))\n    __pxlblz_h = 1\n    __pxlblz_i = 1\n    __pxlblz_w(delta)\n  }\n  __pxlblz_m = ceil(sqrt(pixelCount))\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_r == 0) {\n    if (__pxlblz_q == 0) {\n      var __pxlblz_A = 0\n      var __pxlblz_C = clamp(x, 0, 1)\n      var __pxlblz_D = clamp(y, 0, 1)\n      if (__pxlblz_A == 0) {\n        var __pxlblz_g = __pxlblz_m\n        var __pxlblz_s = __pxlblz_C\n        var __pxlblz_t = __pxlblz_D\n        var __pxlblz_B = min(pixelCount - 1, floor(__pxlblz_t * __pxlblz_g) * __pxlblz_g + floor(__pxlblz_s * __pxlblz_g))\n        var __pxlblz_p\n        var __pxlblz_o\n        var __pxlblz_n\n        __pxlblz_h = 1\n        __pxlblz_v = 0\n        __pxlblz_u = 0\n        __pxlblz_l = pixelCount\n        __pxlblz_y(__pxlblz_B, __pxlblz_s, __pxlblz_t)\n        __pxlblz_p = __pxlblz_f\n        __pxlblz_o = __pxlblz_e\n        __pxlblz_n = __pxlblz_d\n        rgb(__pxlblz_p, __pxlblz_o, __pxlblz_n)\n        return\n      }\n    }\n  }\n  rgb(0, 0, 0)\n}\n\n"
