  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=convertible name=\"Convertible\" hash=9f6341e2 stamped=2026-09-16T00:00:00.000Z\n// pxlblz:transforms show\n// pxlblz:compat portability=adaptive dimensions=2 classes=surface resolution=adaptive exact=false\n// pxlblz:show-output version=1 kind=portable-2d dimensions=2 classes=surface resolution=variable\n/*\n * Compiled PXLBLZ Show: Convertible\n * By: PXLBLZ <pxlblz@whiteroomsoftware.com>\n *\n * Source Patterns:\n * - TestPattern1D [stock:TestPattern1D]\n *   Pattern author metadata was not recorded for these sources.\n *   If original comments are stripped later, this exported Show cannot recover missing author names.\n *\n * Preferred map: none recorded.\n * Compatibility: adaptive 2D surface maps at adaptive resolution; other compatible maps may change the composition.\n * Output contract: Portable 2D · variable resolution · compatible surface maps\n * Layout schedule:\n * - 0.0: Full (1000 ms) [start 0 ms]\n * Clip schedule:\n * - 0.0: TestPattern1D (1000 ms) [clip] [start 0 ms]\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_v = array(2000)\nvar __pxlblz_w = array(2000)\nvar __pxlblz_x = array(2000)\nvar __pxlblz_e = 0\nvar __pxlblz_o = 0\nvar __pxlblz_i = pixelCount\nvar __pxlblz_l = 1\nvar __pxlblz_B = 0\nvar __pxlblz_m = 1\nvar __pxlblz_A = 0\nvar __pxlblz_c = 0\nvar __pxlblz_b = 0\nvar __pxlblz_a = 0\nfunction __pxlblz_L() { __pxlblz_c = 0; __pxlblz_b = 0; __pxlblz_a = 0 }\nfunction __pxlblz_G(r, g, b) { __pxlblz_c = r; __pxlblz_b = g; __pxlblz_a = b }\nfunction __pxlblz_C(delta) {\n  var scaledDelta = delta * __pxlblz_m\n  __pxlblz_o = __pxlblz_o + scaledDelta\n\n  __pxlblz_D(scaledDelta)\n  \n}\nfunction __pxlblz_F(index, x, y) {\n  if (__pxlblz_f && __pxlblz_h == __pxlblz_d && (__pxlblz_d == 1)) {\n    __pxlblz_c = __pxlblz_v[index]\n    __pxlblz_b = __pxlblz_w[index]\n    __pxlblz_a = __pxlblz_x[index]\n    return\n  }\n\n\n  __pxlblz_E(index, x, y)\n\n  if (!__pxlblz_f && __pxlblz_h == __pxlblz_d && (__pxlblz_d == 1)) {\n    __pxlblz_v[index] = __pxlblz_c\n    __pxlblz_w[index] = __pxlblz_b\n    __pxlblz_x[index] = __pxlblz_a\n    if (index == __pxlblz_i - 1) __pxlblz_f = 1\n  }\n}\nfunction __pxlblz_M() { rgb(__pxlblz_c, __pxlblz_b, __pxlblz_a) }\n\nvar __pxlblz_n=0; function __pxlblz_D(delta){__pxlblz_n+=delta} function __pxlblz_E(index,x,y){__pxlblz_G(x,__pxlblz_n/2000,y/2)}\n\nvar __pxlblz_k = 0\n\nvar __pxlblz_d = -1\n\nvar __pxlblz_g = -1\n\nvar __pxlblz_h = -1\n\nvar __pxlblz_f = 0\n\nvar __pxlblz_q = -1\n\nvar __pxlblz_u = 0\n\nvar __pxlblz_p = 0\nexport function beforeRender(delta) {\n  __pxlblz_e = (__pxlblz_e + delta / 1000) % 1\n  __pxlblz_u = 0\n\n  if (__pxlblz_e < 1) {\n    __pxlblz_k = 0\n    __pxlblz_O = -1\n    __pxlblz_N = 0\n     __pxlblz_i = max(1, floor(pixelCount / 1))\n    __pxlblz_l = 1\n    __pxlblz_m = 1\n    __pxlblz_C(delta)\n  }\n  __pxlblz_g = -1\n  if (__pxlblz_k == 0) __pxlblz_g = 1\n  if (__pxlblz_e < __pxlblz_q || __pxlblz_g != __pxlblz_d) {\n    __pxlblz_d = __pxlblz_g\n    __pxlblz_f = 0\n  }\n  __pxlblz_q = __pxlblz_e\n  __pxlblz_p = ceil(sqrt(pixelCount))\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_k == 0) {\n    if (__pxlblz_u == 0) {\n      var __pxlblz_H = 0\n      var __pxlblz_J = clamp(x, 0, 1)\n      var __pxlblz_K = clamp(y, 0, 1)\n      if (__pxlblz_H == 0) {\n        var __pxlblz_j = __pxlblz_p\n        var __pxlblz_y = __pxlblz_J\n        var __pxlblz_z = __pxlblz_K\n        var __pxlblz_I = min(pixelCount - 1, floor(__pxlblz_z * __pxlblz_j) * __pxlblz_j + floor(__pxlblz_y * __pxlblz_j))\n        var __pxlblz_t\n        var __pxlblz_s\n        var __pxlblz_r\n        __pxlblz_l = 1\n        __pxlblz_B = 0\n        __pxlblz_A = 0\n        __pxlblz_h = 1\n        __pxlblz_i = pixelCount\n        __pxlblz_F(__pxlblz_I, __pxlblz_y, __pxlblz_z)\n        __pxlblz_t = __pxlblz_c\n        __pxlblz_s = __pxlblz_b\n        __pxlblz_r = __pxlblz_a\n        rgb(__pxlblz_t, __pxlblz_s, __pxlblz_r)\n        return\n      }\n    }\n  }\n  rgb(0, 0, 0)\n}\n\n"
