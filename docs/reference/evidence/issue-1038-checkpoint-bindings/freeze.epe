    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=convertible name=\"Convertible\" hash=2320fb7f stamped=2026-09-16T00:00:00.000Z\n// pxlblz:transforms show\n// pxlblz:compat portability=adaptive dimensions=2 classes=surface resolution=adaptive exact=false\n// pxlblz:show-output version=1 kind=portable-2d dimensions=2 classes=surface resolution=variable\n/*\n * Compiled PXLBLZ Show: Convertible\n * By: PXLBLZ <pxlblz@whiteroomsoftware.com>\n *\n * Source Patterns:\n * - TestPattern1D [stock:TestPattern1D]\n *   Pattern author metadata was not recorded for these sources.\n *   If original comments are stripped later, this exported Show cannot recover missing author names.\n *\n * Preferred map: none recorded.\n * Compatibility: adaptive 2D surface maps at adaptive resolution; other compatible maps may change the composition.\n * Output contract: Portable 2D · variable resolution · compatible surface maps\n * Layout schedule:\n * - 0.0: Full (1000 ms) [start 0 ms]\n * Clip schedule:\n * - 0.0: TestPattern1D (1000 ms) [clip] [start 0 ms]\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_x = array(2000)\nvar __pxlblz_y = array(2000)\nvar __pxlblz_z = array(2000)\nvar __pxlblz_c = 0\nvar __pxlblz_a = 0\nvar __pxlblz_q = 0\nvar __pxlblz_k = pixelCount\nvar __pxlblz_n = 1\nvar __pxlblz_D = 0\nvar __pxlblz_o = 1\nvar __pxlblz_C = 0\nvar __pxlblz_f = 0\nvar __pxlblz_e = 0\nvar __pxlblz_d = 0\nfunction __pxlblz_N() { __pxlblz_f = 0; __pxlblz_e = 0; __pxlblz_d = 0 }\nfunction __pxlblz_I(r, g, b) { __pxlblz_f = r; __pxlblz_e = g; __pxlblz_d = b }\nfunction __pxlblz_E(delta) {\n  var scaledDelta = delta * __pxlblz_o\n  __pxlblz_q = __pxlblz_q + scaledDelta / 1000\n  __pxlblz_F(scaledDelta)\n  \n}\nfunction __pxlblz_H(index, x, y) {\n  if (__pxlblz_h && __pxlblz_j == __pxlblz_g && (__pxlblz_g == 1)) {\n    __pxlblz_f = __pxlblz_x[index]\n    __pxlblz_e = __pxlblz_y[index]\n    __pxlblz_d = __pxlblz_z[index]\n    return\n  }\n\n\n  __pxlblz_G(index, x, y)\n\n  if (!__pxlblz_h && __pxlblz_j == __pxlblz_g && (__pxlblz_g == 1)) {\n    __pxlblz_x[index] = __pxlblz_f\n    __pxlblz_y[index] = __pxlblz_e\n    __pxlblz_z[index] = __pxlblz_d\n    if (index == __pxlblz_k - 1) __pxlblz_h = 1\n  }\n}\nfunction __pxlblz_O() { rgb(__pxlblz_f, __pxlblz_e, __pxlblz_d) }\n\nvar __pxlblz_p=0; function __pxlblz_F(delta){__pxlblz_p+=delta} function __pxlblz_G(index,x,y){__pxlblz_I(x,__pxlblz_p/2000,y/2)}\n\nvar __pxlblz_m = 0\n\nvar __pxlblz_g = -1\n\nvar __pxlblz_i = -1\n\nvar __pxlblz_j = -1\n\nvar __pxlblz_h = 0\n\nvar __pxlblz_s = -1\n\nvar __pxlblz_w = 0\n\nvar __pxlblz_r = 0\nexport function beforeRender(delta) {\n  var __pxlblz_b = floor(__pxlblz_c - __pxlblz_a / 1000 + 0.5) - 1\n  __pxlblz_a = __pxlblz_a - 1000 + delta\n  while (__pxlblz_a >= 0) {\n    __pxlblz_a = __pxlblz_a - 1000\n    __pxlblz_b = __pxlblz_b + 1\n  }\n  __pxlblz_a = __pxlblz_a + 1000\n  while (__pxlblz_b >= 0) {\n    __pxlblz_b = __pxlblz_b - 1\n  }\n  __pxlblz_b = __pxlblz_b + 1\n  __pxlblz_c = __pxlblz_b + __pxlblz_a / 1000\n  if (__pxlblz_c >= 1) __pxlblz_c = 1 - 0.0000152587890625\n  __pxlblz_w = 0\n\n  if (__pxlblz_c < 1) {\n    __pxlblz_m = 0\n    __pxlblz_Q = -1\n    __pxlblz_P = 0\n     __pxlblz_k = max(1, floor(pixelCount / 1))\n    __pxlblz_n = 1\n    __pxlblz_o = 1\n    __pxlblz_E(delta)\n  }\n  __pxlblz_i = -1\n  if (__pxlblz_m == 0) __pxlblz_i = 1\n  if (__pxlblz_c < __pxlblz_s || __pxlblz_i != __pxlblz_g) {\n    __pxlblz_g = __pxlblz_i\n    __pxlblz_h = 0\n  }\n  __pxlblz_s = __pxlblz_c\n  __pxlblz_r = ceil(sqrt(pixelCount))\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_m == 0) {\n    if (__pxlblz_w == 0) {\n      var __pxlblz_J = 0\n      var __pxlblz_L = clamp(x, 0, 1)\n      var __pxlblz_M = clamp(y, 0, 1)\n      if (__pxlblz_J == 0) {\n        var __pxlblz_l = __pxlblz_r\n        var __pxlblz_A = __pxlblz_L\n        var __pxlblz_B = __pxlblz_M\n        var __pxlblz_K = min(pixelCount - 1, floor(__pxlblz_B * __pxlblz_l) * __pxlblz_l + floor(__pxlblz_A * __pxlblz_l))\n        var __pxlblz_v\n        var __pxlblz_u\n        var __pxlblz_t\n        __pxlblz_n = 1\n        __pxlblz_D = 0\n        __pxlblz_C = 0\n        __pxlblz_j = 1\n        __pxlblz_k = pixelCount\n        __pxlblz_H(__pxlblz_K, __pxlblz_A, __pxlblz_B)\n        __pxlblz_v = __pxlblz_f\n        __pxlblz_u = __pxlblz_e\n        __pxlblz_t = __pxlblz_d\n        rgb(__pxlblz_v, __pxlblz_u, __pxlblz_t)\n        return\n      }\n    }\n  }\n  rgb(0, 0, 0)\n}\n\n"
