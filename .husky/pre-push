#!/bin/sh
# Reuse exact candidate approvals, then run full Vitest and E2E once before push.
#
# Why pre-push (not pre-commit): these are the comprehensive publication gates. The
# pre-commit hook already runs focused tests and high-risk invariants, so paying
# for every Vitest file again on each local commit only duplicates work.
echo "▶ Checking exact candidate-review approvals before publication…"
npm run review:push -- "$1" "$2" && npm run test:full && npm run test:e2e \
  && npm run test:e2e:auth-smoke \
  && npm run test:e2e:shows
