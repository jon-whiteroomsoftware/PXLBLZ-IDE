{
  "name": "Adaptive Spatial Operator Showcase",
  "id": "pxb410SpatOps01",
  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=issue-410-showcase name=\"Adaptive Spatial Operator Showcase\" hash=481fb4f2 stamped=2026-07-11T14:30:00.000Z\n// pxlblz:transforms show adaptive-spatial-operators\n// Adaptive Spatial Operator Showcase (#410)\n// Two continuously running Patterns are composed through seven Stage-space operators.\nvar elapsed = 0\nvar t = 0\nexport function beforeRender(delta) { elapsed = (elapsed + delta) % 28000; t = t + delta * 0.001 }\nexport function render2D(index, x, y) {\n  var scene = floor(elapsed / 4000)\n  var region = 0; var lx = x; var ly = y; var mix = 0\n  if (scene == 0) { var column = min(2, floor(x * 3)); var row = min(1, floor(y * 2)); region = row * 3 + column; lx = clamp(x * 3 - column, 0, 1); ly = clamp(y * 2 - row, 0, 1) }\n  else if (scene == 1) { var stripe = min(5, floor(frac(x + t * 0.08) * 6)); region = stripe; lx = frac(x + t * 0.08) * 6 - stripe }\n  else if (scene == 2) { var column = min(5, floor(x * 6)); var row = min(3, floor(y * 4)); region = (row + column) % 2; lx = clamp(x * 6 - column, 0, 1); ly = clamp(y * 4 - row, 0, 1) }\n  else if (scene == 3) { var dx = x - 0.5; var dy = y - 0.5; var radius = clamp(hypot(dx, dy) / 0.70710678, 0, 1); region = min(4, floor(radius * 5)); lx = frac(atan2(dy, dx) / 6.2831853 + 1); ly = clamp(radius * 5 - region, 0, 1) }\n  else if (scene == 4) { var dx = x - 0.5; var dy = y - 0.5; var radius = hypot(dx, dy); var turn = frac(atan2(dy, dx) / 6.2831853 + radius * 1.35 + t * 0.04 + 1); region = min(5, floor(turn * 6)); lx = clamp(turn * 6 - region, 0, 1); ly = clamp(radius / 0.70710678, 0, 1) }\n  else if (scene == 5) { var shifted = frac(y + (triangle(x * 2.5 + t * 0.1) - 0.5) * 0.3); region = min(3, floor(shifted * 4)); ly = clamp(shifted * 4 - region, 0, 1) }\n  else if (scene == 6) { var signed = x - (0.5 + (triangle(t * 0.05) - 0.5) * 0.5); mix = clamp(0.5 + signed / 0.16, 0, 1); region = mix >= 0.5 }\n  if (scene != 6) mix = region % 2\n  var ar = 0.18 + 0.82 * triangle(lx * 3 + t * 0.11)\n  var ag = 0.04 + 0.28 * triangle(ly * 5 - t * 0.07)\n  var ab = 0.12 + 0.35 * triangle(lx + ly + t * 0.03)\n  var br = 0.08 + 0.22 * triangle(ly * 4 + t * 0.05)\n  var bg = 0.18 + 0.82 * triangle(lx * 5 - t * 0.09)\n  var bb = 0.28 + 0.62 * triangle(lx - ly + t * 0.06)\n  rgb(ar * (1 - mix) + br * mix, ag * (1 - mix) + bg * mix, ab * (1 - mix) + bb * mix)\n}"
  },
  "preview": ""
}