{
  "name": "Scene Splice Showcase",
  "id": "pxbFmAuzv94taH4rw",
  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=catalog-scene-splice-showcase name=\"Scene Splice Showcase\" hash=e475790b stamped=2026-07-10T22:00:00.000Z\n// pxlblz:transforms show spatial-transitions\n// pxlblz:map preferred=stock:plane name=\"Square\"\n// pxlblz:compat portability=installation-bound dimensions=2 classes=surface resolution=fixed exact=true\n/*\n * Compiled PXLBLZ Show: Scene Splice Showcase\n *\n * Source Patterns:\n * - Heat Shimmer Tiles [stock:HeatShimmerTiles]\n * - Neon Circuit Board [stock:NeonCircuitBoard]\n *   Detailed provenance and license comments remain embedded in each isolated member source.\n *\n * Routing Layouts: Default\n * Preferred map: Square [stock:plane].\n * Compatibility: installation-bound 2D surface map at fixed resolution; this artifact expects the authored installation/map.\n * Scenes:\n * - Heat shimmer (3.5s): portal 3s, center 0.5/0.5, outward, blend feather 0.14\n * - Neon circuitry (3.5s): portal 2.6s, center 0.28/0.68, inward, dither feather 0.08\n * - Heat shimmer return (3.5s)\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_show_elapsed_s = 0\nvar __pxlblz_show_mix = 0\nvar __pxlblz_show_phase = 0\nvar __pxlblz_show_c0_elapsed_ms = 0\nvar __pxlblz_show_c0_pixelCount = pixelCount\nvar __pxlblz_show_c0_adapt_brightness = 1\nvar __pxlblz_show_c0_adapt_phase = 0\nvar __pxlblz_show_c0_adapt_timeScale = 1\nvar __pxlblz_show_c0_adapt_mirror = 0\nvar __pxlblz_show_c0_r = 0\nvar __pxlblz_show_c0_g = 0\nvar __pxlblz_show_c0_b = 0\nfunction __pxlblz_show_c0_clear() { __pxlblz_show_c0_r = 0; __pxlblz_show_c0_g = 0; __pxlblz_show_c0_b = 0 }\nfunction __pxlblz_show_c0_rgb(r, g, b) { __pxlblz_show_c0_r = r; __pxlblz_show_c0_g = g; __pxlblz_show_c0_b = b }\nfunction __pxlblz_show_c0_hsv(h, s, v) { __pxlblz_show_capture_hsv(0, h + __pxlblz_show_c0_adapt_phase, s, v) }\nfunction __pxlblz_show_c0_applyOutputEffects() {\n  __pxlblz_show_c0_r = __pxlblz_show_c0_r * __pxlblz_show_c0_adapt_brightness\n  __pxlblz_show_c0_g = __pxlblz_show_c0_g * __pxlblz_show_c0_adapt_brightness\n  __pxlblz_show_c0_b = __pxlblz_show_c0_b * __pxlblz_show_c0_adapt_brightness\n}\nfunction __pxlblz_show_c0_time(interval) { return (__pxlblz_show_c0_elapsed_ms / (interval * 65536)) % 1 }\nfunction __pxlblz_show_c0_setAdaptation(brightness, phase, timeScale, mirror) {\n  __pxlblz_show_c0_adapt_brightness = brightness\n  __pxlblz_show_c0_adapt_phase = phase\n  __pxlblz_show_c0_adapt_timeScale = timeScale\n  __pxlblz_show_c0_adapt_mirror = mirror\n}\nfunction __pxlblz_show_c0_mixAdaptation(fromBrightness, fromPhase, fromTimeScale, fromMirror, toBrightness, toPhase, toTimeScale, toMirror, mix) {\n  __pxlblz_show_c0_setAdaptation(\n    fromBrightness + (toBrightness - fromBrightness) * mix,\n    fromPhase + (toPhase - fromPhase) * mix,\n    fromTimeScale + (toTimeScale - fromTimeScale) * mix,\n    mix < 0.5 ? fromMirror : toMirror\n  )\n}\nfunction __pxlblz_show_c0_advance(delta) {\n  var scaledDelta = delta * __pxlblz_show_c0_adapt_timeScale\n  __pxlblz_show_c0_elapsed_ms = __pxlblz_show_c0_elapsed_ms + scaledDelta\n  __pxlblz_show_c0_beforeRender(scaledDelta)\n}\nfunction __pxlblz_show_c0_renderCapture(index) {\n  var mappedIndex = index\n  if (__pxlblz_show_c0_adapt_mirror >= 0.5) mappedIndex = __pxlblz_show_c0_pixelCount - 1 - index\n  __pxlblz_show_c0_clear()\n  \n  __pxlblz_show_c0_applyOutputEffects()\n}\nfunction __pxlblz_show_c0_renderCapture2D(index, x, y) {\n  var mappedIndex = index\n  var mappedX = x\n  if (__pxlblz_show_c0_adapt_mirror >= 0.5) {\n    mappedIndex = __pxlblz_show_c0_pixelCount - 1 - index\n    mappedX = 1 - x\n  }\n  __pxlblz_show_c0_clear()\n  __pxlblz_show_c0_render2D(mappedIndex, mappedX, y)\n  __pxlblz_show_c0_applyOutputEffects()\n}\nfunction __pxlblz_show_c0_emit() { rgb(__pxlblz_show_c0_r, __pxlblz_show_c0_g, __pxlblz_show_c0_b) }\nvar __pxlblz_show_c1_elapsed_ms = 0\nvar __pxlblz_show_c1_pixelCount = pixelCount\nvar __pxlblz_show_c1_adapt_brightness = 1\nvar __pxlblz_show_c1_adapt_phase = 0\nvar __pxlblz_show_c1_adapt_timeScale = 1\nvar __pxlblz_show_c1_adapt_mirror = 0\nvar __pxlblz_show_c1_r = 0\nvar __pxlblz_show_c1_g = 0\nvar __pxlblz_show_c1_b = 0\nfunction __pxlblz_show_c1_clear() { __pxlblz_show_c1_r = 0; __pxlblz_show_c1_g = 0; __pxlblz_show_c1_b = 0 }\nfunction __pxlblz_show_c1_rgb(r, g, b) { __pxlblz_show_c1_r = r; __pxlblz_show_c1_g = g; __pxlblz_show_c1_b = b }\nfunction __pxlblz_show_c1_hsv(h, s, v) { __pxlblz_show_capture_hsv(1, h + __pxlblz_show_c1_adapt_phase, s, v) }\nfunction __pxlblz_show_c1_applyOutputEffects() {\n  __pxlblz_show_c1_r = __pxlblz_show_c1_r * __pxlblz_show_c1_adapt_brightness\n  __pxlblz_show_c1_g = __pxlblz_show_c1_g * __pxlblz_show_c1_adapt_brightness\n  __pxlblz_show_c1_b = __pxlblz_show_c1_b * __pxlblz_show_c1_adapt_brightness\n}\nfunction __pxlblz_show_c1_time(interval) { return (__pxlblz_show_c1_elapsed_ms / (interval * 65536)) % 1 }\nfunction __pxlblz_show_c1_setAdaptation(brightness, phase, timeScale, mirror) {\n  __pxlblz_show_c1_adapt_brightness = brightness\n  __pxlblz_show_c1_adapt_phase = phase\n  __pxlblz_show_c1_adapt_timeScale = timeScale\n  __pxlblz_show_c1_adapt_mirror = mirror\n}\nfunction __pxlblz_show_c1_mixAdaptation(fromBrightness, fromPhase, fromTimeScale, fromMirror, toBrightness, toPhase, toTimeScale, toMirror, mix) {\n  __pxlblz_show_c1_setAdaptation(\n    fromBrightness + (toBrightness - fromBrightness) * mix,\n    fromPhase + (toPhase - fromPhase) * mix,\n    fromTimeScale + (toTimeScale - fromTimeScale) * mix,\n    mix < 0.5 ? fromMirror : toMirror\n  )\n}\nfunction __pxlblz_show_c1_advance(delta) {\n  var scaledDelta = delta * __pxlblz_show_c1_adapt_timeScale\n  __pxlblz_show_c1_elapsed_ms = __pxlblz_show_c1_elapsed_ms + scaledDelta\n  __pxlblz_show_c1_beforeRender(scaledDelta)\n}\nfunction __pxlblz_show_c1_renderCapture(index) {\n  var mappedIndex = index\n  if (__pxlblz_show_c1_adapt_mirror >= 0.5) mappedIndex = __pxlblz_show_c1_pixelCount - 1 - index\n  __pxlblz_show_c1_clear()\n  \n  __pxlblz_show_c1_applyOutputEffects()\n}\nfunction __pxlblz_show_c1_renderCapture2D(index, x, y) {\n  var mappedIndex = index\n  var mappedX = x\n  if (__pxlblz_show_c1_adapt_mirror >= 0.5) {\n    mappedIndex = __pxlblz_show_c1_pixelCount - 1 - index\n    mappedX = 1 - x\n  }\n  __pxlblz_show_c1_clear()\n  __pxlblz_show_c1_render2D(mappedIndex, mappedX, y)\n  __pxlblz_show_c1_applyOutputEffects()\n}\nfunction __pxlblz_show_c1_emit() { rgb(__pxlblz_show_c1_r, __pxlblz_show_c1_g, __pxlblz_show_c1_b) }\nfunction __pxlblz_show_capture_rgb(slot, r, g, b) {\n  if (slot == 0) { __pxlblz_show_c0_r = r; __pxlblz_show_c0_g = g; __pxlblz_show_c0_b = b }\n  else { __pxlblz_show_c1_r = r; __pxlblz_show_c1_g = g; __pxlblz_show_c1_b = b }\n}\nfunction __pxlblz_show_capture_hsv(slot, h, s, v) {\n  h = h - floor(h)\n  var i = floor(h * 6)\n  var f = h * 6 - i\n  var p = v * (1 - s)\n  var q = v * (1 - f * s)\n  var t = v * (1 - (1 - f) * s)\n  if (i == 0) __pxlblz_show_capture_rgb(slot, v, t, p)\n  else if (i == 1) __pxlblz_show_capture_rgb(slot, q, v, p)\n  else if (i == 2) __pxlblz_show_capture_rgb(slot, p, v, t)\n  else if (i == 3) __pxlblz_show_capture_rgb(slot, p, q, v)\n  else if (i == 4) __pxlblz_show_capture_rgb(slot, t, p, v)\n  else __pxlblz_show_capture_rgb(slot, v, p, q)\n}\nfunction __pxlblz_show_hash01(index) {\n  return frac((index + 1) * 0.61803398875)\n}\n\n// Heat Shimmer Tiles — repeated colour panes bending under a slow heat haze.\n// License: ISC\n//\n// The shimmer is just coordinate offsets from triangle waves. No perlin needed.\n\nvar __pxlblz_show_c0_speed = 0.57       // shimmer speed\nvar __pxlblz_show_c0_tileSize = 0.50    // tile density\nvar __pxlblz_show_c0_shimmer = 0.62     // bend amount\nvar __pxlblz_show_c0_palette = 0.04     // base heat colour\n\nfunction __pxlblz_show_c0_sliderSpeed(v) { __pxlblz_show_c0_speed = v }\nfunction __pxlblz_show_c0_sliderTileSize(v) { __pxlblz_show_c0_tileSize = v }\nfunction __pxlblz_show_c0_sliderShimmer(v) { __pxlblz_show_c0_shimmer = v }\nfunction __pxlblz_show_c0_sliderPalette(v) { __pxlblz_show_c0_palette = v }\n\nvar __pxlblz_show_c0_t = 0\nvar __pxlblz_show_c0_cells, __pxlblz_show_c0_bend\n\nfunction __pxlblz_show_c0_beforeRender(delta) {\n  __pxlblz_show_c0_t = __pxlblz_show_c0_t + delta * 0.001 * (0.16 + __pxlblz_show_c0_speed * 1.35)\n  __pxlblz_show_c0_cells = 5 + floor(__pxlblz_show_c0_tileSize * 9)\n  __pxlblz_show_c0_bend = 0.025 + __pxlblz_show_c0_shimmer * 0.065\n}\n\nfunction __pxlblz_show_c0_render2D(index, x, y) {\n  var sx = x + (triangle(y * 4.0 + __pxlblz_show_c0_t * 0.22) - 0.5) * __pxlblz_show_c0_bend\n  var sy = y + (triangle(x * 3.2 - __pxlblz_show_c0_t * 0.17) - 0.5) * __pxlblz_show_c0_bend\n  var gx = frac(sx * __pxlblz_show_c0_cells)\n  var gy = frac(sy * __pxlblz_show_c0_cells)\n  var edge = max(clamp(1 - min(gx, 1 - gx) * 18, 0, 1),\n                 clamp(1 - min(gy, 1 - gy) * 18, 0, 1))\n  var warmth = triangle(gx * 0.8 + gy * 1.1 + __pxlblz_show_c0_t * 0.05)\n  var val = clamp(0.18 + warmth * 0.45 + edge * 0.26, 0, 1)\n  __pxlblz_show_c0_hsv(frac(__pxlblz_show_c0_palette + warmth * 0.12 + y * 0.08), 0.86 - edge * 0.25, val)\n}\n\n// Neon Circuit Board — pulsing traces, vias, and packet glints.\n// License: ISC\n//\n// Built from repeated coordinates plus cheap axis/diagonal distances. The first\n// draft used true SDF capsules/circles; these approximations keep the circuit\n// look and avoid several hypot calls per pixel.\n\nvar __pxlblz_show_c1_speed = 0.62       // packet speed\nvar __pxlblz_show_c1_density = 0.08     // cell density\nvar __pxlblz_show_c1_pulse = 0.85       // packet brightness\nvar __pxlblz_show_c1_hue = 0.43         // trace colour\n\nfunction __pxlblz_show_c1_sliderSpeed(v) { __pxlblz_show_c1_speed = v }\nfunction __pxlblz_show_c1_sliderDensity(v) { __pxlblz_show_c1_density = v }\nfunction __pxlblz_show_c1_sliderPulse(v) { __pxlblz_show_c1_pulse = v }\nfunction __pxlblz_show_c1_sliderHue(v) { __pxlblz_show_c1_hue = v }\n\nvar __pxlblz_show_c1_t = 0\nvar __pxlblz_show_c1_cells, __pxlblz_show_c1_w, __pxlblz_show_c1_packetGain\n\nfunction __pxlblz_show_c1_beforeRender(delta) {\n  __pxlblz_show_c1_t = __pxlblz_show_c1_t + delta * 0.001 * (0.22 + __pxlblz_show_c1_speed * 1.8)\n  __pxlblz_show_c1_cells = 4 + floor(__pxlblz_show_c1_density * 7)\n  __pxlblz_show_c1_w = 0.018 + __pxlblz_show_c1_density * 0.002\n  __pxlblz_show_c1_packetGain = 0.25 + __pxlblz_show_c1_pulse * 0.75\n}\n\nfunction __pxlblz_show_c1_render2D(index, x, y) {\n  var gx = frac(x * __pxlblz_show_c1_cells)\n  var gy = frac(y * __pxlblz_show_c1_cells)\n  var id = floor(x * __pxlblz_show_c1_cells) + floor(y * __pxlblz_show_c1_cells) * 7\n\n  var h = abs(gy - 0.50) - __pxlblz_show_c1_w\n  var v = abs(gx - 0.50) - __pxlblz_show_c1_w * 0.82\n  var d1 = abs((gy - 0.18) - (gx - 0.12) * 0.86) - __pxlblz_show_c1_w * 0.65\n  var d2 = abs((gy - 0.84) + (gx - 0.18) * 1.06) - __pxlblz_show_c1_w * 0.55\n  var route = min(min(h, v), min(d1, d2))\n\n  var trace = clamp(1 - abs(route) * 12.5, 0, 1)\n  var via0 = max(abs(gx - 0.50), abs(gy - 0.50))\n  var via1 = max(abs(gx - 0.12), abs(gy - 0.18))\n  var via = max(clamp(1 - via0 * 18, 0, 1), clamp(1 - via1 * 22, 0, 1))\n\n  var packet = triangle(gx + gy + __pxlblz_show_c1_t * 0.28 + id * 0.137)\n  packet = packet * packet * packet * __pxlblz_show_c1_packetGain\n\n  var val = clamp(trace * (0.28 + packet) + via * 0.5, 0, 1)\n  __pxlblz_show_c1_hsv(frac(__pxlblz_show_c1_hue + id * 0.021 + packet * 0.05), 0.9 - via * 0.22, val)\n}\n\nvar __pxlblz_show_scene = 0\n\nvar __pxlblz_show_transition = -1\n\nexport function beforeRender(delta) {\n  __pxlblz_show_elapsed_s = (__pxlblz_show_elapsed_s + delta / 1000) % 16.1\n  if (__pxlblz_show_elapsed_s < 3.5) {\n    __pxlblz_show_scene = 0\n    __pxlblz_show_transition = -1\n    __pxlblz_show_mix = 0\n    __pxlblz_show_c0_advance(delta)\n  } else if (__pxlblz_show_elapsed_s < 6.5) {\n    __pxlblz_show_scene = 0\n    __pxlblz_show_transition = 0\n    __pxlblz_show_mix = (__pxlblz_show_elapsed_s - 3.5) / 3\n    __pxlblz_show_c0_advance(delta)\n    __pxlblz_show_c1_advance(delta)\n  } else if (__pxlblz_show_elapsed_s < 10) {\n    __pxlblz_show_scene = 1\n    __pxlblz_show_transition = -1\n    __pxlblz_show_mix = 0\n    __pxlblz_show_c1_advance(delta)\n  } else if (__pxlblz_show_elapsed_s < 12.6) {\n    __pxlblz_show_scene = 1\n    __pxlblz_show_transition = 1\n    __pxlblz_show_mix = (__pxlblz_show_elapsed_s - 10) / 2.6\n    __pxlblz_show_c1_advance(delta)\n    __pxlblz_show_c0_advance(delta)\n  } else if (__pxlblz_show_elapsed_s < 16.1) {\n    __pxlblz_show_scene = 2\n    __pxlblz_show_transition = -1\n    __pxlblz_show_mix = 0\n    __pxlblz_show_c0_advance(delta)\n  }\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_show_transition >= 0) {\n    if (__pxlblz_show_transition == 0) {\n    var __pxlblz_show_portal_distance = hypot(x - 0.5, y - 0.5)\n    var __pxlblz_show_portal_radius = 0.7071067811865476 * __pxlblz_show_mix\n    var __pxlblz_show_portal_signed = __pxlblz_show_portal_distance - __pxlblz_show_portal_radius\n    var __pxlblz_show_portal_mix = clamp(0.5 - __pxlblz_show_portal_signed / 0.14, 0, 1)\n    if (__pxlblz_show_portal_mix <= 0) {\n      __pxlblz_show_c0_renderCapture2D(index, x, y)\n      __pxlblz_show_c0_emit()\n    } else if (__pxlblz_show_portal_mix >= 1) {\n      __pxlblz_show_c1_renderCapture2D(index, x, y)\n      __pxlblz_show_c1_emit()\n    } else {\n      __pxlblz_show_c0_renderCapture2D(index, x, y)\n      var r0 = __pxlblz_show_c0_r\n      var g0 = __pxlblz_show_c0_g\n      var b0 = __pxlblz_show_c0_b\n      __pxlblz_show_c1_renderCapture2D(index, x, y)\n      rgb(\n        r0 * (1 - __pxlblz_show_portal_mix) + __pxlblz_show_c1_r * __pxlblz_show_portal_mix,\n        g0 * (1 - __pxlblz_show_portal_mix) + __pxlblz_show_c1_g * __pxlblz_show_portal_mix,\n        b0 * (1 - __pxlblz_show_portal_mix) + __pxlblz_show_c1_b * __pxlblz_show_portal_mix\n      )\n    }\n  } else if (__pxlblz_show_transition == 1) {\n    var __pxlblz_show_portal_distance = hypot(x - 0.28, y - 0.68)\n    var __pxlblz_show_portal_radius = 0.9903534722511959 * (1 - __pxlblz_show_mix)\n    var __pxlblz_show_portal_signed = __pxlblz_show_portal_radius - __pxlblz_show_portal_distance\n    var __pxlblz_show_portal_mix = clamp(0.5 - __pxlblz_show_portal_signed / 0.08, 0, 1)\n    if (__pxlblz_show_portal_mix >= 1 || (__pxlblz_show_portal_mix > 0 && __pxlblz_show_hash01(index) < __pxlblz_show_portal_mix)) {\n      __pxlblz_show_c0_renderCapture2D(index, x, y)\n      __pxlblz_show_c0_emit()\n    } else {\n      __pxlblz_show_c1_renderCapture2D(index, x, y)\n      __pxlblz_show_c1_emit()\n    }\n  }\n  } else {\n    if (__pxlblz_show_scene == 0) {\n    __pxlblz_show_c0_renderCapture2D(index, x, y)\n    __pxlblz_show_c0_emit()\n  } else if (__pxlblz_show_scene == 1) {\n    __pxlblz_show_c1_renderCapture2D(index, x, y)\n    __pxlblz_show_c1_emit()\n  } else if (__pxlblz_show_scene == 2) {\n    __pxlblz_show_c0_renderCapture2D(index, x, y)\n    __pxlblz_show_c0_emit()\n  }\n  }\n}\n\n"
  },
  "preview": ""
}