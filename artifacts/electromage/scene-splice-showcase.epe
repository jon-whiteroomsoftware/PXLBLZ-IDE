  "name": "Scene Splice Showcase",
  "id": "pxbFmAuzv94taH4rw",
  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=catalog-scene-splice-showcase name=\"Scene Splice Showcase\" hash=a5f4675d stamped=2026-07-10T22:00:00.000Z\n// pxlblz:transforms show spatial-transitions\n// pxlblz:map preferred=stock:plane name=\"Square\"\n// pxlblz:compat portability=installation-bound dimensions=2 classes=surface resolution=fixed exact=true\n/*\n * Compiled PXLBLZ Show: Scene Splice Showcase\n *\n * Source Patterns:\n * - Heat Shimmer Tiles [stock:HeatShimmerTiles]\n * - Neon Circuit Board [stock:NeonCircuitBoard]\n *   Detailed provenance and license comments remain embedded in each isolated member source.\n *\n * Routing Layouts: Default\n * Preferred map: Square [stock:plane].\n * Compatibility: installation-bound 2D surface map at fixed resolution; this artifact expects the authored installation/map.\n * Scenes:\n * - Heat shimmer (3.5s): portal 3s, center 0.5/0.5, outward, blend feather 0.14\n * - Neon circuitry (3.5s): portal 2.6s, center 0.28/0.68, inward, dither feather 0.08\n * - Heat shimmer return (3.5s)\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_b = 0\nvar __pxlblz_e = 0\nvar __pxlblz_aq = 0\nvar __pxlblz_C = 0\nvar __pxlblz_ab = pixelCount\nvar __pxlblz_Y = 1\nvar __pxlblz_N = 0\nvar __pxlblz_O = 1\nvar __pxlblz_Z = 0\nvar __pxlblz_i = 0\nvar __pxlblz_h = 0\nvar __pxlblz_g = 0\nfunction __pxlblz_aa() { __pxlblz_i = 0; __pxlblz_h = 0; __pxlblz_g = 0 }\nfunction __pxlblz_ac(r, g, b) { __pxlblz_i = r; __pxlblz_h = g; __pxlblz_g = b }\nfunction __pxlblz_Q(h, s, v) { __pxlblz_M(0, h + __pxlblz_N, s, v) }\nfunction __pxlblz_q(delta) {\n  var scaledDelta = delta * __pxlblz_O\n  __pxlblz_C = __pxlblz_C + scaledDelta\n\n  __pxlblz_P(scaledDelta)\n}\nfunction __pxlblz_j(index, x, y) {\n\n\n  __pxlblz_R(index, x, y)\n\n}\nfunction __pxlblz_r() { rgb(__pxlblz_i, __pxlblz_h, __pxlblz_g) }\nvar __pxlblz_H = 0\nvar __pxlblz_ak = pixelCount\nvar __pxlblz_ah = 1\nvar __pxlblz_S = 0\nvar __pxlblz_T = 1\nvar __pxlblz_ai = 0\nvar __pxlblz_o = 0\nvar __pxlblz_n = 0\nvar __pxlblz_l = 0\nfunction __pxlblz_aj() { __pxlblz_o = 0; __pxlblz_n = 0; __pxlblz_l = 0 }\nfunction __pxlblz_al(r, g, b) { __pxlblz_o = r; __pxlblz_n = g; __pxlblz_l = b }\nfunction __pxlblz_V(h, s, v) { __pxlblz_M(1, h + __pxlblz_S, s, v) }\nfunction __pxlblz_v(delta) {\n  var scaledDelta = delta * __pxlblz_T\n  __pxlblz_H = __pxlblz_H + scaledDelta\n\n  __pxlblz_U(scaledDelta)\n}\nfunction __pxlblz_s(index, x, y) {\n\n\n  __pxlblz_W(index, x, y)\n\n}\nfunction __pxlblz_x() { rgb(__pxlblz_o, __pxlblz_n, __pxlblz_l) }\nfunction __pxlblz_f(slot, r, g, b) {\n  if (slot == 0) { __pxlblz_i = r; __pxlblz_h = g; __pxlblz_g = b }\n  else { __pxlblz_o = r; __pxlblz_n = g; __pxlblz_l = b }\n}\nfunction __pxlblz_M(slot, h, s, v) {\n  h = h - floor(h)\n  var i = floor(h * 6)\n  var f = h * 6 - i\n  var p = v * (1 - s)\n  var q = v * (1 - f * s)\n  var t = v * (1 - (1 - f) * s)\n  if (i == 0) __pxlblz_f(slot, v, t, p)\n  else if (i == 1) __pxlblz_f(slot, q, v, p)\n  else if (i == 2) __pxlblz_f(slot, p, v, t)\n  else if (i == 3) __pxlblz_f(slot, p, q, v)\n  else if (i == 4) __pxlblz_f(slot, t, p, v)\n  else __pxlblz_f(slot, v, p, q)\n}\nfunction __pxlblz_X(index) {\n  return frac((index + 1) * 0.61803398875)\n}\n\n// Heat Shimmer Tiles — repeated colour panes bending under a slow heat haze.\n// License: ISC\n//\n// The shimmer is just coordinate offsets from triangle waves. No perlin needed.\n\nvar __pxlblz_F = 0.57       // shimmer speed\nvar __pxlblz_G = 0.50    // tile density\nvar __pxlblz_E = 0.62     // bend amount\nvar __pxlblz_D = 0.04     // base heat colour\n\nfunction __pxlblz_af(v) { __pxlblz_F = v }\nfunction __pxlblz_ag(v) { __pxlblz_G = v }\nfunction __pxlblz_ae(v) { __pxlblz_E = v }\nfunction __pxlblz_ad(v) { __pxlblz_D = v }\n\nvar __pxlblz_k = 0\nvar __pxlblz_u, __pxlblz_t\n\nfunction __pxlblz_P(delta) {\n  __pxlblz_k = __pxlblz_k + delta * 0.001 * (0.16 + __pxlblz_F * 1.35)\n  __pxlblz_u = 5 + floor(__pxlblz_G * 9)\n  __pxlblz_t = 0.025 + __pxlblz_E * 0.065\n}\n\nfunction __pxlblz_R(index, x, y) {\n  var sx = x + (triangle(y * 4.0 + __pxlblz_k * 0.22) - 0.5) * __pxlblz_t\n  var sy = y + (triangle(x * 3.2 - __pxlblz_k * 0.17) - 0.5) * __pxlblz_t\n  var gx = frac(sx * __pxlblz_u)\n  var gy = frac(sy * __pxlblz_u)\n  var edge = max(clamp(1 - min(gx, 1 - gx) * 18, 0, 1),\n                 clamp(1 - min(gy, 1 - gy) * 18, 0, 1))\n  var warmth = triangle(gx * 0.8 + gy * 1.1 + __pxlblz_k * 0.05)\n  var val = clamp(0.18 + warmth * 0.45 + edge * 0.26, 0, 1)\n  __pxlblz_Q(frac(__pxlblz_D + warmth * 0.12 + y * 0.08), 0.86 - edge * 0.25, val)\n}\n\n// Neon Circuit Board — pulsing traces, vias, and packet glints.\n// License: ISC\n//\n// Built from repeated coordinates plus cheap axis/diagonal distances. The first\n// draft used true SDF capsules/circles; these approximations keep the circuit\n// look and avoid several hypot calls per pixel.\n\nvar __pxlblz_L = 0.62       // packet speed\nvar __pxlblz_w = 0.08     // cell density\nvar __pxlblz_K = 0.85       // packet brightness\nvar __pxlblz_I = 0.43         // trace colour\n\nfunction __pxlblz_ap(v) { __pxlblz_L = v }\nfunction __pxlblz_am(v) { __pxlblz_w = v }\nfunction __pxlblz_ao(v) { __pxlblz_K = v }\nfunction __pxlblz_an(v) { __pxlblz_I = v }\n\nvar __pxlblz_y = 0\nvar __pxlblz_m, __pxlblz_p, __pxlblz_J\n\nfunction __pxlblz_U(delta) {\n  __pxlblz_y = __pxlblz_y + delta * 0.001 * (0.22 + __pxlblz_L * 1.8)\n  __pxlblz_m = 4 + floor(__pxlblz_w * 7)\n  __pxlblz_p = 0.018 + __pxlblz_w * 0.002\n  __pxlblz_J = 0.25 + __pxlblz_K * 0.75\n}\n\nfunction __pxlblz_W(index, x, y) {\n  var gx = frac(x * __pxlblz_m)\n  var gy = frac(y * __pxlblz_m)\n  var id = floor(x * __pxlblz_m) + floor(y * __pxlblz_m) * 7\n\n  var h = abs(gy - 0.50) - __pxlblz_p\n  var v = abs(gx - 0.50) - __pxlblz_p * 0.82\n  var d1 = abs((gy - 0.18) - (gx - 0.12) * 0.86) - __pxlblz_p * 0.65\n  var d2 = abs((gy - 0.84) + (gx - 0.18) * 1.06) - __pxlblz_p * 0.55\n  var route = min(min(h, v), min(d1, d2))\n\n  var trace = clamp(1 - abs(route) * 12.5, 0, 1)\n  var via0 = max(abs(gx - 0.50), abs(gy - 0.50))\n  var via1 = max(abs(gx - 0.12), abs(gy - 0.18))\n  var via = max(clamp(1 - via0 * 18, 0, 1), clamp(1 - via1 * 22, 0, 1))\n\n  var packet = triangle(gx + gy + __pxlblz_y * 0.28 + id * 0.137)\n  packet = packet * packet * packet * __pxlblz_J\n\n  var val = clamp(trace * (0.28 + packet) + via * 0.5, 0, 1)\n  __pxlblz_V(frac(__pxlblz_I + id * 0.021 + packet * 0.05), 0.9 - via * 0.22, val)\n}\n\nvar __pxlblz_c = 0\n\nvar __pxlblz_d = -1\n\nexport function beforeRender(delta) {\n  __pxlblz_b = (__pxlblz_b + delta / 1000) % 16.1\n  if (__pxlblz_b < 3.5) {\n    __pxlblz_c = 0\n    __pxlblz_d = -1\n    __pxlblz_e = 0\n    __pxlblz_q(delta)\n  } else if (__pxlblz_b < 6.5) {\n    __pxlblz_c = 0\n    __pxlblz_d = 0\n    __pxlblz_e = (__pxlblz_b - 3.5) / 3\n    __pxlblz_q(delta)\n    __pxlblz_v(delta)\n  } else if (__pxlblz_b < 10) {\n    __pxlblz_c = 1\n    __pxlblz_d = -1\n    __pxlblz_e = 0\n    __pxlblz_v(delta)\n  } else if (__pxlblz_b < 12.6) {\n    __pxlblz_c = 1\n    __pxlblz_d = 1\n    __pxlblz_e = (__pxlblz_b - 10) / 2.6\n    __pxlblz_v(delta)\n    __pxlblz_q(delta)\n  } else if (__pxlblz_b < 16.1) {\n    __pxlblz_c = 2\n    __pxlblz_d = -1\n    __pxlblz_e = 0\n    __pxlblz_q(delta)\n  }\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_d >= 0) {\n    if (__pxlblz_d == 0) {\n    var __pxlblz_z = hypot(x - 0.5, y - 0.5)\n    var __pxlblz_A = 0.7071067811865476 * __pxlblz_e\n    var __pxlblz_B = __pxlblz_z - __pxlblz_A\n    var __pxlblz_a = clamp(0.5 - __pxlblz_B / 0.14, 0, 1)\n    if (__pxlblz_a <= 0) {\n      __pxlblz_j(index, x, y)\n      __pxlblz_r()\n    } else if (__pxlblz_a >= 1) {\n      __pxlblz_s(index, x, y)\n      __pxlblz_x()\n    } else {\n      __pxlblz_j(index, x, y)\n      var r0 = __pxlblz_i\n      var g0 = __pxlblz_h\n      var b0 = __pxlblz_g\n      __pxlblz_s(index, x, y)\n      rgb(\n        r0 * (1 - __pxlblz_a) + __pxlblz_o * __pxlblz_a,\n        g0 * (1 - __pxlblz_a) + __pxlblz_n * __pxlblz_a,\n        b0 * (1 - __pxlblz_a) + __pxlblz_l * __pxlblz_a\n      )\n    }\n  } else if (__pxlblz_d == 1) {\n    var __pxlblz_z = hypot(x - 0.28, y - 0.68)\n    var __pxlblz_A = 0.9903534722511959 * (1 - __pxlblz_e)\n    var __pxlblz_B = __pxlblz_A - __pxlblz_z\n    var __pxlblz_a = clamp(0.5 - __pxlblz_B / 0.08, 0, 1)\n    if (__pxlblz_a >= 1 || (__pxlblz_a > 0 && __pxlblz_X(index) < __pxlblz_a)) {\n      __pxlblz_j(index, x, y)\n      __pxlblz_r()\n    } else {\n      __pxlblz_s(index, x, y)\n      __pxlblz_x()\n    }\n  }\n  } else {\n    if (__pxlblz_c == 0) {\n    __pxlblz_j(index, x, y)\n    __pxlblz_r()\n  } else if (__pxlblz_c == 1) {\n    __pxlblz_s(index, x, y)\n    __pxlblz_x()\n  } else if (__pxlblz_c == 2) {\n    __pxlblz_j(index, x, y)\n    __pxlblz_r()\n  }\n  }\n}\n\n"
  },
  "preview": ""
}