  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=catalog-pattern-prism name=\"Pattern Prism: One Pattern, Many Layouts\" hash=00723081 stamped=2026-07-10T21:00:00.000Z\n// pxlblz:transforms show routing-layouts\n// pxlblz:map preferred=stock:plane name=\"Square\"\n// pxlblz:compat portability=installation-bound dimensions=2 classes=surface resolution=fixed exact=true\n/*\n * Compiled PXLBLZ Show: Pattern Prism: One Pattern, Many Layouts\n *\n * Source Patterns:\n * - Ribbon Loom [stock:RibbonLoom]\n *   Detailed provenance and license comments remain embedded in each isolated member source.\n *\n * Routing Layouts: Full panel -> Four quadrants -> Alternating vertical strips -> Pinwheel interleave\n * Preferred map: Square [stock:plane].\n * Compatibility: installation-bound 2D surface map at fixed resolution; this artifact expects the authored installation/map.\n * Scenes:\n * - Full panel (5s): switch to Four quadrants after scene\n * - Four quadrants (5s): switch to Alternating vertical strips after scene\n * - Vertical strips (5s): switch to Pinwheel interleave after scene\n * - Pinwheel weave (5s): switch to Full panel after scene\n * - Full panel return (5s)\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_l = 0\nvar __pxlblz_W = 0\nvar __pxlblz_X = 0\nvar __pxlblz_v = 0\nvar __pxlblz_e = pixelCount\nvar __pxlblz_K = 1\nvar __pxlblz_D = 0\nvar __pxlblz_E = 1\nvar __pxlblz_L = 0\nvar __pxlblz_q = 0\nvar __pxlblz_p = 0\nvar __pxlblz_o = 0\nfunction __pxlblz_M() { __pxlblz_q = 0; __pxlblz_p = 0; __pxlblz_o = 0 }\nfunction __pxlblz_N(r, g, b) { __pxlblz_q = r; __pxlblz_p = g; __pxlblz_o = b }\nfunction __pxlblz_H(h, s, v) { __pxlblz_J(0, h + __pxlblz_D, s, v) }\nfunction __pxlblz_F(delta) {\n  var scaledDelta = delta * __pxlblz_E\n  __pxlblz_v = __pxlblz_v + scaledDelta\n\n  __pxlblz_G(scaledDelta)\n}\nfunction __pxlblz_h(index, x, y) {\n\n\n  __pxlblz_I(index, x, y)\n\n}\nfunction __pxlblz_g() { rgb(__pxlblz_q, __pxlblz_p, __pxlblz_o) }\nfunction __pxlblz_k(slot, r, g, b) {\n  if (slot == 0) { __pxlblz_q = r; __pxlblz_p = g; __pxlblz_o = b }\n  else { __pxlblz_U = r; __pxlblz_T = g; __pxlblz_S = b }\n}\nfunction __pxlblz_J(slot, h, s, v) {\n  h = h - floor(h)\n  var i = floor(h * 6)\n  var f = h * 6 - i\n  var p = v * (1 - s)\n  var q = v * (1 - f * s)\n  var t = v * (1 - (1 - f) * s)\n  if (i == 0) __pxlblz_k(slot, v, t, p)\n  else if (i == 1) __pxlblz_k(slot, q, v, p)\n  else if (i == 2) __pxlblz_k(slot, p, v, t)\n  else if (i == 3) __pxlblz_k(slot, p, q, v)\n  else if (i == 4) __pxlblz_k(slot, t, p, v)\n  else __pxlblz_k(slot, v, p, q)\n}\nfunction __pxlblz_V(index) {\n  return frac((index + 1) * 0.61803398875)\n}\n\n// Ribbon Loom — luminous SDF ribbons weaving over and under each other.\n// License: ISC\n//\n// A small fixed set of triangle-wave paths is enough to suggest fabric. The\n// first draft used per-pixel sine paths; triangle paths keep the weave language\n// while being much friendlier on Pixelblaze hardware.\n\nvar __pxlblz_B = 1          // weave motion\nvar __pxlblz_C = 0          // ribbon width\nvar __pxlblz_u = 0.79       // number of active ribbon families\nvar __pxlblz_m = 0.57     // base hue\n\nfunction __pxlblz_Q(v) { __pxlblz_B = v }\nfunction __pxlblz_R(v) { __pxlblz_C = v }\nfunction __pxlblz_O(v) { __pxlblz_u = v }\nfunction __pxlblz_P(v) { __pxlblz_m = v }\n\nvar __pxlblz_j = 0\nvar __pxlblz_s, __pxlblz_t, __pxlblz_w\nvar __pxlblz_x, __pxlblz_y, __pxlblz_z, __pxlblz_A\n\nfunction __pxlblz_G(delta) {\n  __pxlblz_j = __pxlblz_j + delta * 0.001 * (0.2 + __pxlblz_B * 1.6)\n  __pxlblz_s = 0.018 + __pxlblz_C * 0.055\n  __pxlblz_w = 1 / (__pxlblz_s + 0.055)\n  __pxlblz_t = 3 + floor(__pxlblz_u * 2) // 3..5 apparent ribbons, capped for hardware FPS\n  __pxlblz_x = __pxlblz_j * 0.18\n  __pxlblz_y = __pxlblz_j * 0.21 + 0.27\n  __pxlblz_z = __pxlblz_j * 0.24 + 0.54\n  __pxlblz_A = __pxlblz_j * 0.27 + 0.81\n}\n\nfunction __pxlblz_r(x, y, lane, amp, freq, phase, hueOffset) {\n  var path = (triangle(x * freq + phase) - 0.5) * 2\n  var d = abs(y - (lane + amp * path))\n  var body = clamp(1 - d * __pxlblz_w, 0, 1)\n  var edge = clamp(1 - abs(d - __pxlblz_s) * 85, 0, 1)\n  var weave = triangle(x * (freq + 2.2) + phase)\n  var over = weave > 0.5 ? 1.1 : 0.74\n  return body * body * over + edge * 0.22 + hueOffset * 0.0001\n}\n\nfunction __pxlblz_I(index, x, y) {\n  var c0 = __pxlblz_r(x, y, 0.22, 0.08, 1.25, __pxlblz_x, 0)\n  var c1 = __pxlblz_r(x, y, 0.40, 0.10, 1.48, __pxlblz_y, 1)\n  var c2 = __pxlblz_r(x, y, 0.58, 0.09, 1.72, __pxlblz_z, 2)\n  var c3 = 0\n  // The fourth ribbon only occupies the top band; skipping it elsewhere keeps\n  // the full high-count look while avoiding a wasted path evaluation per pixel.\n  if (__pxlblz_t > 3 && y > 0.56) c3 = __pxlblz_r(x, y, 0.76, 0.11, 1.96, __pxlblz_A, 3)\n\n  var val = c0\n  var hue = __pxlblz_m\n  if (c1 > val) { val = c1; hue = __pxlblz_m + 0.145 }\n  if (c2 > val) { val = c2; hue = __pxlblz_m + 0.290 }\n  if (c3 > val) { val = c3; hue = __pxlblz_m + 0.435 }\n\n  // Subtle loom threads in the background.\n  var thread = 0.08 * triangle(x * 18 + __pxlblz_j * 0.05) * triangle(y * 14 - __pxlblz_j * 0.04)\n  __pxlblz_H(frac(hue + val * 0.04), 0.88, clamp(val + thread, 0, 1))\n}\n\nvar __pxlblz_a = array(1024)\n__pxlblz_a[0] = 1\n__pxlblz_a[1] = 2\n__pxlblz_a[2] = 3\n__pxlblz_a[3] = 4\n__pxlblz_a[4] = 5\n__pxlblz_a[5] = 6\n__pxlblz_a[6] = 7\n__pxlblz_a[7] = 8\n__pxlblz_a[8] = 9\n__pxlblz_a[9] = 10\n__pxlblz_a[10] = 11\n__pxlblz_a[11] = 12\n__pxlblz_a[12] = 13\n__pxlblz_a[13] = 14\n__pxlblz_a[14] = 15\n__pxlblz_a[15] = 16\n__pxlblz_a[16] = 17\n__pxlblz_a[17] = 18\n__pxlblz_a[18] = 19\n__pxlblz_a[19] = 20\n__pxlblz_a[20] = 21\n__pxlblz_a[21] = 22\n__pxlblz_a[22] = 23\n__pxlblz_a[23] = 24\n__pxlblz_a[24] = 25\n__pxlblz_a[25] = 26\n__pxlblz_a[26] = 27\n__pxlblz_a[27] = 28\n__pxlblz_a[28] = 29\n__pxlblz_a[29] = 30\n__pxlblz_a[30] = 31\n__pxlblz_a[31] = 32\n__pxlblz_a[32] = 33\n__pxlblz_a[33] = 34\n__pxlblz_a[34] = 35\n__pxlblz_a[35] = 36\n__pxlblz_a[36] = 37\n__pxlblz_a[37] = 38\n__pxlblz_a[38] = 39\n__pxlblz_a[39] = 40\n__pxlblz_a[40] = 41\n__pxlblz_a[41] = 42\n__pxlblz_a[42] = 43\n__pxlblz_a[43] = 44\n__pxlblz_a[44] = 45\n__pxlblz_a[45] = 46\n__pxlblz_a[46] = 47\n__pxlblz_a[47] = 48\n__pxlblz_a[48] = 49\n__pxlblz_a[49] = 50\n__pxlblz_a[50] = 51\n__pxlblz_a[51] = 52\n__pxlblz_a[52] = 53\n__pxlblz_a[53] = 54\n__pxlblz_a[54] = 55\n__pxlblz_a[55] = 56\n__pxlblz_a[56] = 57\n__pxlblz_a[57] = 58\n__pxlblz_a[58] = 59\n__pxlblz_a[59] = 60\n__pxlblz_a[60] = 61\n__pxlblz_a[61] = 62\n__pxlblz_a[62] = 63\n__pxlblz_a[63] = 64\n__pxlblz_a[64] = 65\n__pxlblz_a[65] = 66\n__pxlblz_a[66] = 67\n__pxlblz_a[67] = 68\n__pxlblz_a[68] = 69\n__pxlblz_a[69] = 70\n__pxlblz_a[70] = 71\n__pxlblz_a[71] = 72\n__pxlblz_a[72] = 73\n__pxlblz_a[73] = 74\n__pxlblz_a[74] = 75\n__pxlblz_a[75] = 76\n__pxlblz_a[76] = 77\n__pxlblz_a[77] = 78\n__pxlblz_a[78] = 79\n__pxlblz_a[79] = 80\n__pxlblz_a[80] = 81\n__pxlblz_a[81] = 82\n__pxlblz_a[82] = 83\n__pxlblz_a[83] = 84\n__pxlblz_a[84] = 85\n__pxlblz_a[85] = 86\n__pxlblz_a[86] = 87\n__pxlblz_a[87] = 88\n__pxlblz_a[88] = 89\n__pxlblz_a[89] = 90\n__pxlblz_a[90] = 91\n__pxlblz_a[91] = 92\n__pxlblz_a[92] = 93\n__pxlblz_a[93] = 94\n__pxlblz_a[94] = 95\n__pxlblz_a[95] = 96\n__pxlblz_a[96] = 97\n__pxlblz_a[97] = 98\n__pxlblz_a[98] = 99\n__pxlblz_a[99] = 100\n__pxlblz_a[100] = 101\n__pxlblz_a[101] = 102\n__pxlblz_a[102] = 103\n__pxlblz_a[103] = 104\n__pxlblz_a[104] = 105\n__pxlblz_a[105] = 106\n__pxlblz_a[106] = 107\n__pxlblz_a[107] = 108\n__pxlblz_a[108] = 109\n__pxlblz_a[109] = 110\n__pxlblz_a[110] = 111\n__pxlblz_a[111] = 112\n__pxlblz_a[112] = 113\n__pxlblz_a[113] = 114\n__pxlblz_a[114] = 115\n__pxlblz_a[115] = 116\n__pxlblz_a[116] = 117\n__pxlblz_a[117] = 118\n__pxlblz_a[118] = 119\n__px