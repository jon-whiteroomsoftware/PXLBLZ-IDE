{
  "name": "Pattern Prism: One Pattern, Many Layouts",
  "id": "pxbECxRAHBYMond7k",
  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=catalog-pattern-prism name=\"Pattern Prism: One Pattern, Many Layouts\" hash=42afa48c stamped=2026-07-10T21:00:00.000Z\n// pxlblz:transforms show routing-layouts\n/*\n * Compiled PXLBLZ Show: Pattern Prism: One Pattern, Many Layouts\n *\n * Source Patterns:\n * - Ribbon Loom [stock:RibbonLoom]\n *   Detailed provenance and license comments remain embedded in each isolated member source.\n *\n * Routing Layouts: Full panel -> Four quadrants -> Alternating vertical strips -> Pinwheel interleave\n * Scenes:\n * - Full panel (5s): switch to Four quadrants after scene\n * - Four quadrants (5s): switch to Alternating vertical strips after scene\n * - Vertical strips (5s): switch to Pinwheel interleave after scene\n * - Pinwheel weave (5s): switch to Full panel after scene\n * - Full panel return (5s)\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_show_elapsed_ms = 0\nvar __pxlblz_show_mix = 0\nvar __pxlblz_show_phase = 0\nvar __pxlblz_show_c0_elapsed_ms = 0\nvar __pxlblz_show_c0_pixelCount = pixelCount\nvar __pxlblz_show_c0_adapt_brightness = 1\nvar __pxlblz_show_c0_adapt_phase = 0\nvar __pxlblz_show_c0_adapt_timeScale = 1\nvar __pxlblz_show_c0_adapt_mirror = 0\nvar __pxlblz_show_c0_r = 0\nvar __pxlblz_show_c0_g = 0\nvar __pxlblz_show_c0_b = 0\nfunction __pxlblz_show_c0_clear() { __pxlblz_show_c0_r = 0; __pxlblz_show_c0_g = 0; __pxlblz_show_c0_b = 0 }\nfunction __pxlblz_show_c0_rgb(r, g, b) { __pxlblz_show_c0_r = r * __pxlblz_show_c0_adapt_brightness; __pxlblz_show_c0_g = g * __pxlblz_show_c0_adapt_brightness; __pxlblz_show_c0_b = b * __pxlblz_show_c0_adapt_brightness }\nfunction __pxlblz_show_c0_hsv(h, s, v) { __pxlblz_show_capture_hsv(0, h + __pxlblz_show_c0_adapt_phase, s, v * __pxlblz_show_c0_adapt_brightness) }\nfunction __pxlblz_show_c0_time(interval) { return ((__pxlblz_show_c0_elapsed_ms * 0.001) / interval) % 1 }\nfunction __pxlblz_show_c0_setAdaptation(brightness, phase, timeScale, mirror) {\n  __pxlblz_show_c0_adapt_brightness = brightness\n  __pxlblz_show_c0_adapt_phase = phase\n  __pxlblz_show_c0_adapt_timeScale = timeScale\n  __pxlblz_show_c0_adapt_mirror = mirror\n}\nfunction __pxlblz_show_c0_mixAdaptation(fromBrightness, fromPhase, fromTimeScale, fromMirror, toBrightness, toPhase, toTimeScale, toMirror, mix) {\n  __pxlblz_show_c0_setAdaptation(\n    fromBrightness + (toBrightness - fromBrightness) * mix,\n    fromPhase + (toPhase - fromPhase) * mix,\n    fromTimeScale + (toTimeScale - fromTimeScale) * mix,\n    mix < 0.5 ? fromMirror : toMirror\n  )\n}\nfunction __pxlblz_show_c0_advance(delta) {\n  var scaledDelta = delta * __pxlblz_show_c0_adapt_timeScale\n  __pxlblz_show_c0_elapsed_ms = __pxlblz_show_c0_elapsed_ms + scaledDelta\n  __pxlblz_show_c0_beforeRender(scaledDelta)\n}\nfunction __pxlblz_show_c0_renderCapture(index) {\n  var mappedIndex = index\n  if (__pxlblz_show_c0_adapt_mirror >= 0.5) mappedIndex = __pxlblz_show_c0_pixelCount - 1 - index\n  __pxlblz_show_c0_clear()\n  \n}\nfunction __pxlblz_show_c0_renderCapture2D(index, x, y) {\n  var mappedIndex = index\n  var mappedX = x\n  if (__pxlblz_show_c0_adapt_mirror >= 0.5) {\n    mappedIndex = __pxlblz_show_c0_pixelCount - 1 - index\n    mappedX = 1 - x\n  }\n  __pxlblz_show_c0_clear()\n  __pxlblz_show_c0_render2D(mappedIndex, mappedX, y)\n}\nfunction __pxlblz_show_c0_emit() { rgb(__pxlblz_show_c0_r, __pxlblz_show_c0_g, __pxlblz_show_c0_b) }\nfunction __pxlblz_show_capture_rgb(slot, r, g, b) {\n  if (slot == 0) { __pxlblz_show_c0_r = r; __pxlblz_show_c0_g = g; __pxlblz_show_c0_b = b }\n  else { __pxlblz_show_c1_r = r; __pxlblz_show_c1_g = g; __pxlblz_show_c1_b = b }\n}\nfunction __pxlblz_show_capture_hsv(slot, h, s, v) {\n  h = h - floor(h)\n  var i = floor(h * 6)\n  var f = h * 6 - i\n  var p = v * (1 - s)\n  var q = v * (1 - f * s)\n  var t = v * (1 - (1 - f) * s)\n  if (i == 0) __pxlblz_show_capture_rgb(slot, v, t, p)\n  else if (i == 1) __pxlblz_show_capture_rgb(slot, q, v, p)\n  else if (i == 2) __pxlblz_show_capture_rgb(slot, p, v, t)\n  else if (i == 3) __pxlblz_show_capture_rgb(slot, p, q, v)\n  else if (i == 4) __pxlblz_show_capture_rgb(slot, t, p, v)\n  else __pxlblz_show_capture_rgb(slot, v, p, q)\n}\nfunction __pxlblz_show_hash01(index) {\n  return frac((index + 1) * 0.61803398875)\n}\n\n// Ribbon Loom — luminous SDF ribbons weaving over and under each other.\n// License: ISC\n//\n// A small fixed set of triangle-wave paths is enough to suggest fabric. The\n// first draft used per-pixel sine paths; triangle paths keep the weave language\n// while being much friendlier on Pixelblaze hardware.\n\nvar __pxlblz_show_c0_speed = 1          // weave motion\nvar __pxlblz_show_c0_width = 0          // ribbon width\nvar __pxlblz_show_c0_count = 0.79       // number of active ribbon families\nvar __pxlblz_show_c0_palette = 0.57     // base hue\n\nfunction __pxlblz_show_c0_sliderSpeed(v) { __pxlblz_show_c0_speed = v }\nfunction __pxlblz_show_c0_sliderWidth(v) { __pxlblz_show_c0_width = v }\nfunction __pxlblz_show_c0_sliderCount(v) { __pxlblz_show_c0_count = v }\nfunction __pxlblz_show_c0_sliderPalette(v) { __pxlblz_show_c0_palette = v }\n\nvar __pxlblz_show_c0_t = 0\nvar __pxlblz_show_c0_w, __pxlblz_show_c0_active, __pxlblz_show_c0_invW\nvar __pxlblz_show_c0_p0, __pxlblz_show_c0_p1, __pxlblz_show_c0_p2, __pxlblz_show_c0_p3\n\nfunction __pxlblz_show_c0_beforeRender(delta) {\n  __pxlblz_show_c0_t = __pxlblz_show_c0_t + delta * 0.001 * (0.2 + __pxlblz_show_c0_speed * 1.6)\n  __pxlblz_show_c0_w = 0.018 + __pxlblz_show_c0_width * 0.055\n  __pxlblz_show_c0_invW = 1 / (__pxlblz_show_c0_w + 0.055)\n  __pxlblz_show_c0_active = 3 + floor(__pxlblz_show_c0_count * 2) // 3..5 apparent ribbons, capped for hardware FPS\n  __pxlblz_show_c0_p0 = __pxlblz_show_c0_t * 0.18\n  __pxlblz_show_c0_p1 = __pxlblz_show_c0_t * 0.21 + 0.27\n  __pxlblz_show_c0_p2 = __pxlblz_show_c0_t * 0.24 + 0.54\n  __pxlblz_show_c0_p3 = __pxlblz_show_c0_t * 0.27 + 0.81\n}\n\nfunction __pxlblz_show_c0_ribbonValue(x, y, lane, amp, freq, phase, hueOffset) {\n  var path = (triangle(x * freq + phase) - 0.5) * 2\n  var d = abs(y - (lane + amp * path))\n  var body = clamp(1 - d * __pxlblz_show_c0_invW, 0, 1)\n  var edge = clamp(1 - abs(d - __pxlblz_show_c0_w) * 85, 0, 1)\n  var weave = triangle(x * (freq + 2.2) + phase)\n  var over = weave > 0.5 ? 1.1 : 0.74\n  return body * body * over + edge * 0.22 + hueOffset * 0.0001\n}\n\nfunction __pxlblz_show_c0_render2D(index, x, y) {\n  var c0 = __pxlblz_show_c0_ribbonValue(x, y, 0.22, 0.08, 1.25, __pxlblz_show_c0_p0, 0)\n  var c1 = __pxlblz_show_c0_ribbonValue(x, y, 0.40, 0.10, 1.48, __pxlblz_show_c0_p1, 1)\n  var c2 = __pxlblz_show_c0_ribbonValue(x, y, 0.58, 0.09, 1.72, __pxlblz_show_c0_p2, 2)\n  var c3 = 0\n  // The fourth ribbon only occupies the top band; skipping it elsewhere keeps\n  // the full high-count look while avoiding a wasted path evaluation per pixel.\n  if (__pxlblz_show_c0_active > 3 && y > 0.56) c3 = __pxlblz_show_c0_ribbonValue(x, y, 0.76, 0.11, 1.96, __pxlblz_show_c0_p3, 3)\n\n  var val = c0\n  var hue = __pxlblz_show_c0_palette\n  if (c1 > val) { val = c1; hue = __pxlblz_show_c0_palette + 0.145 }\n  if (c2 > val) { val = c2; hue = __pxlblz_show_c0_palette + 0.290 }\n  if (c3 > val) { val = c3; hue = __pxlblz_show_c0_palette + 0.435 }\n\n  // Subtle loom threads in the background.\n  var thread = 0.08 * triangle(x * 18 + __pxlblz_show_c0_t * 0.05) * triangle(y * 14 - __pxlblz_show_c0_t * 0.04)\n  __pxlblz_show_c0_hsv(frac(hue + val * 0.04), 0.88, clamp(val + thread, 0, 1))\n}\n\nvar __pxlblz_show_route_pixels = array(1024)\n__pxlblz_show_route_pixels[0] = 1\n__pxlblz_show_route_pixels[1] = 2\n__pxlblz_show_route_pixels[2] = 3\n__pxlblz_show_route_pixels[3] = 4\n__pxlblz_show_route_pixels[4] = 5\n__pxlblz_show_route_pixels[5] = 6\n__pxlblz_show_route_pixels[6] = 7\n__pxlblz_show_route_pixels[7] = 8\n__pxlblz_show_route_pixels[8] = 9\n__pxlblz_show_route_pixels[9] = 10\n__pxlblz_show_route_pixels[10] = 11\n__pxlblz_show_route_pixels[11] = 12\n__pxlblz_show_route_pixels[12] = 13\n__pxlblz_show_route_pixels[13] = 14\n__pxlblz_show_route_pixels[14] = 15\n__pxlblz_show_route_pixels[15] = 16\n__pxlblz_show_route_pixels[16] = 17\n__pxlblz_show_route_pixels[17] = 18\n__pxlblz_show_route_pixels[18] = 19\n__pxlblz_show_route_pixels[19] = 20\n__pxlblz_show_route_pixels[20] = 21\n__pxlblz_show_route_pixels[21] = 22\n__pxlblz_show_route_pixels[22] = 23\n__pxlblz_show_route_pixels[23] = 24\n__pxlblz_show_route_pixels[24] = 25\n__pxlblz_show_route_pixels[25] = 26\n__pxlblz_show_route_pixels[26] = 27\n__pxlblz_show_route_pixels[27] = 28\n__pxlblz_show_route_pixels[28] = 29\n__pxlblz_show_route_pixels[29] = 30\n__pxlblz_show_route_pixels[30] = 31\n__pxlblz_show_route_pixels[31] = 32\n__pxlblz_show_route_pixels[32] = 33\n__pxlblz_show_route_pixels[33] = 34\n__pxlblz_show_route_pixels[34] = 35\n__pxlblz_show_route_pixels[35] = 36\n__pxlblz_show_route_pixels[36] = 37\n__pxlblz_show_route_pixels[37] = 38\n__pxlblz_show_route_pixels[38] = 39\n__pxlblz_show_route_pixels[39] = 40\n__pxlblz_show_route_pixels[40] = 41\n__pxlblz_show_route_pixels[41] = 42\n__pxlblz_show_route_pixels[42] = 43\n__pxlblz_show_route_pixels[43] = 44\n__pxlblz_show_route_pixels[44] = 45\n__pxlblz_show_route_pixels[45] = 46\n__pxlblz_show_route_pixels[46] = 47\n__pxlblz_show_route_pixels[47] = 48\n__pxlblz_show_route_pixels[48] = 49\n__pxlblz_show_route_pixels[49] = 50\n__pxlblz_show_route_pixels[50] = 51\n__pxlblz_show_route_pixels[51] = 52\n__pxlblz_show_route_pixels[52] = 53\n__pxlblz_show_route_pixels[53] = 54\n__pxlblz_show_route_pixels[54] = 55\n__pxlblz_show_route_pixels[55] = 56\n__pxlblz_show_route_pixels[56] = 57\n__pxlblz_show_route_pixels[57] = 58\n__pxlblz_show_route_pixels[58] = 59\n__pxlblz_show_route_pixels[59] =