{
  "name": "Pattern Prism: Adaptive Layouts",
  "id": "pxb409AdptvPrsm",
  "sources": {
    "main": "// Built with PXLBLZ-IDE https://pxlblz-ide.whiteroomsoftware.com/\n// pxlblz:1 kind=show id=catalog-pattern-prism-adaptive name=\"Pattern Prism: Adaptive Layouts\" hash=9b7707ab stamped=2026-07-11T13:30:00.000Z\n// pxlblz:transforms show routing-layouts\n/*\n * Compiled PXLBLZ Show: Pattern Prism: Adaptive Layouts\n *\n * Source Patterns:\n * - Ribbon Loom [stock:RibbonLoom]\n *   Detailed provenance and license comments remain embedded in each isolated member source.\n *\n * Routing Layouts: Full panel -> Four quadrants -> Alternating vertical strips -> Pinwheel interleave\n * Scenes:\n * - Full panel (5s): switch to Four quadrants after scene\n * - Four quadrants (5s): switch to Alternating vertical strips after scene\n * - Vertical strips (5s): switch to Pinwheel interleave after scene\n * - Pinwheel weave (5s): switch to Full panel after scene\n * - Full panel return (5s)\n *\n * Generated orchestration follows; member bindings are isolated with collision-safe prefixes.\n * This file is an ordinary standalone Pixelblaze Pattern after compilation.\n */\nvar __pxlblz_show_elapsed_ms = 0\nvar __pxlblz_show_mix = 0\nvar __pxlblz_show_phase = 0\nvar __pxlblz_show_c0_elapsed_ms = 0\nvar __pxlblz_show_c0_pixelCount = pixelCount\nvar __pxlblz_show_c0_adapt_brightness = 1\nvar __pxlblz_show_c0_adapt_phase = 0\nvar __pxlblz_show_c0_adapt_timeScale = 1\nvar __pxlblz_show_c0_adapt_mirror = 0\nvar __pxlblz_show_c0_r = 0\nvar __pxlblz_show_c0_g = 0\nvar __pxlblz_show_c0_b = 0\nfunction __pxlblz_show_c0_clear() { __pxlblz_show_c0_r = 0; __pxlblz_show_c0_g = 0; __pxlblz_show_c0_b = 0 }\nfunction __pxlblz_show_c0_rgb(r, g, b) { __pxlblz_show_c0_r = r * __pxlblz_show_c0_adapt_brightness; __pxlblz_show_c0_g = g * __pxlblz_show_c0_adapt_brightness; __pxlblz_show_c0_b = b * __pxlblz_show_c0_adapt_brightness }\nfunction __pxlblz_show_c0_hsv(h, s, v) { __pxlblz_show_capture_hsv(0, h + __pxlblz_show_c0_adapt_phase, s, v * __pxlblz_show_c0_adapt_brightness) }\nfunction __pxlblz_show_c0_time(interval) { return ((__pxlblz_show_c0_elapsed_ms * 0.001) / interval) % 1 }\nfunction __pxlblz_show_c0_setAdaptation(brightness, phase, timeScale, mirror) {\n  __pxlblz_show_c0_adapt_brightness = brightness\n  __pxlblz_show_c0_adapt_phase = phase\n  __pxlblz_show_c0_adapt_timeScale = timeScale\n  __pxlblz_show_c0_adapt_mirror = mirror\n}\nfunction __pxlblz_show_c0_mixAdaptation(fromBrightness, fromPhase, fromTimeScale, fromMirror, toBrightness, toPhase, toTimeScale, toMirror, mix) {\n  __pxlblz_show_c0_setAdaptation(\n    fromBrightness + (toBrightness - fromBrightness) * mix,\n    fromPhase + (toPhase - fromPhase) * mix,\n    fromTimeScale + (toTimeScale - fromTimeScale) * mix,\n    mix < 0.5 ? fromMirror : toMirror\n  )\n}\nfunction __pxlblz_show_c0_advance(delta) {\n  var scaledDelta = delta * __pxlblz_show_c0_adapt_timeScale\n  __pxlblz_show_c0_elapsed_ms = __pxlblz_show_c0_elapsed_ms + scaledDelta\n  __pxlblz_show_c0_beforeRender(scaledDelta)\n}\nfunction __pxlblz_show_c0_renderCapture(index) {\n  var mappedIndex = index\n  if (__pxlblz_show_c0_adapt_mirror >= 0.5) mappedIndex = __pxlblz_show_c0_pixelCount - 1 - index\n  __pxlblz_show_c0_clear()\n  \n}\nfunction __pxlblz_show_c0_renderCapture2D(index, x, y) {\n  var mappedIndex = index\n  var mappedX = x\n  if (__pxlblz_show_c0_adapt_mirror >= 0.5) {\n    mappedIndex = __pxlblz_show_c0_pixelCount - 1 - index\n    mappedX = 1 - x\n  }\n  __pxlblz_show_c0_clear()\n  __pxlblz_show_c0_render2D(mappedIndex, mappedX, y)\n}\nfunction __pxlblz_show_c0_emit() { rgb(__pxlblz_show_c0_r, __pxlblz_show_c0_g, __pxlblz_show_c0_b) }\nfunction __pxlblz_show_capture_rgb(slot, r, g, b) {\n  if (slot == 0) { __pxlblz_show_c0_r = r; __pxlblz_show_c0_g = g; __pxlblz_show_c0_b = b }\n  else { __pxlblz_show_c1_r = r; __pxlblz_show_c1_g = g; __pxlblz_show_c1_b = b }\n}\nfunction __pxlblz_show_capture_hsv(slot, h, s, v) {\n  h = h - floor(h)\n  var i = floor(h * 6)\n  var f = h * 6 - i\n  var p = v * (1 - s)\n  var q = v * (1 - f * s)\n  var t = v * (1 - (1 - f) * s)\n  if (i == 0) __pxlblz_show_capture_rgb(slot, v, t, p)\n  else if (i == 1) __pxlblz_show_capture_rgb(slot, q, v, p)\n  else if (i == 2) __pxlblz_show_capture_rgb(slot, p, v, t)\n  else if (i == 3) __pxlblz_show_capture_rgb(slot, p, q, v)\n  else if (i == 4) __pxlblz_show_capture_rgb(slot, t, p, v)\n  else __pxlblz_show_capture_rgb(slot, v, p, q)\n}\nfunction __pxlblz_show_hash01(index) {\n  return frac((index + 1) * 0.61803398875)\n}\n\n// Ribbon Loom — luminous SDF ribbons weaving over and under each other.\n// License: ISC\n//\n// A small fixed set of triangle-wave paths is enough to suggest fabric. The\n// first draft used per-pixel sine paths; triangle paths keep the weave language\n// while being much friendlier on Pixelblaze hardware.\n\nvar __pxlblz_show_c0_speed = 1          // weave motion\nvar __pxlblz_show_c0_width = 0          // ribbon width\nvar __pxlblz_show_c0_count = 0.79       // number of active ribbon families\nvar __pxlblz_show_c0_palette = 0.57     // base hue\n\nfunction __pxlblz_show_c0_sliderSpeed(v) { __pxlblz_show_c0_speed = v }\nfunction __pxlblz_show_c0_sliderWidth(v) { __pxlblz_show_c0_width = v }\nfunction __pxlblz_show_c0_sliderCount(v) { __pxlblz_show_c0_count = v }\nfunction __pxlblz_show_c0_sliderPalette(v) { __pxlblz_show_c0_palette = v }\n\nvar __pxlblz_show_c0_t = 0\nvar __pxlblz_show_c0_w, __pxlblz_show_c0_active, __pxlblz_show_c0_invW\nvar __pxlblz_show_c0_p0, __pxlblz_show_c0_p1, __pxlblz_show_c0_p2, __pxlblz_show_c0_p3\n\nfunction __pxlblz_show_c0_beforeRender(delta) {\n  __pxlblz_show_c0_t = __pxlblz_show_c0_t + delta * 0.001 * (0.2 + __pxlblz_show_c0_speed * 1.6)\n  __pxlblz_show_c0_w = 0.018 + __pxlblz_show_c0_width * 0.055\n  __pxlblz_show_c0_invW = 1 / (__pxlblz_show_c0_w + 0.055)\n  __pxlblz_show_c0_active = 3 + floor(__pxlblz_show_c0_count * 2) // 3..5 apparent ribbons, capped for hardware FPS\n  __pxlblz_show_c0_p0 = __pxlblz_show_c0_t * 0.18\n  __pxlblz_show_c0_p1 = __pxlblz_show_c0_t * 0.21 + 0.27\n  __pxlblz_show_c0_p2 = __pxlblz_show_c0_t * 0.24 + 0.54\n  __pxlblz_show_c0_p3 = __pxlblz_show_c0_t * 0.27 + 0.81\n}\n\nfunction __pxlblz_show_c0_ribbonValue(x, y, lane, amp, freq, phase, hueOffset) {\n  var path = (triangle(x * freq + phase) - 0.5) * 2\n  var d = abs(y - (lane + amp * path))\n  var body = clamp(1 - d * __pxlblz_show_c0_invW, 0, 1)\n  var edge = clamp(1 - abs(d - __pxlblz_show_c0_w) * 85, 0, 1)\n  var weave = triangle(x * (freq + 2.2) + phase)\n  var over = weave > 0.5 ? 1.1 : 0.74\n  return body * body * over + edge * 0.22 + hueOffset * 0.0001\n}\n\nfunction __pxlblz_show_c0_render2D(index, x, y) {\n  var c0 = __pxlblz_show_c0_ribbonValue(x, y, 0.22, 0.08, 1.25, __pxlblz_show_c0_p0, 0)\n  var c1 = __pxlblz_show_c0_ribbonValue(x, y, 0.40, 0.10, 1.48, __pxlblz_show_c0_p1, 1)\n  var c2 = __pxlblz_show_c0_ribbonValue(x, y, 0.58, 0.09, 1.72, __pxlblz_show_c0_p2, 2)\n  var c3 = 0\n  // The fourth ribbon only occupies the top band; skipping it elsewhere keeps\n  // the full high-count look while avoiding a wasted path evaluation per pixel.\n  if (__pxlblz_show_c0_active > 3 && y > 0.56) c3 = __pxlblz_show_c0_ribbonValue(x, y, 0.76, 0.11, 1.96, __pxlblz_show_c0_p3, 3)\n\n  var val = c0\n  var hue = __pxlblz_show_c0_palette\n  if (c1 > val) { val = c1; hue = __pxlblz_show_c0_palette + 0.145 }\n  if (c2 > val) { val = c2; hue = __pxlblz_show_c0_palette + 0.290 }\n  if (c3 > val) { val = c3; hue = __pxlblz_show_c0_palette + 0.435 }\n\n  // Subtle loom threads in the background.\n  var thread = 0.08 * triangle(x * 18 + __pxlblz_show_c0_t * 0.05) * triangle(y * 14 - __pxlblz_show_c0_t * 0.04)\n  __pxlblz_show_c0_hsv(frac(hue + val * 0.04), 0.88, clamp(val + thread, 0, 1))\n}\n\n\n\nvar __pxlblz_show_route_layout = 0\n\nexport function beforeRender(delta) {\n  __pxlblz_show_elapsed_ms = (__pxlblz_show_elapsed_ms + delta) % 25000\n  __pxlblz_show_route_layout = 0\n  if (__pxlblz_show_elapsed_ms >= 5000) __pxlblz_show_route_layout = 1\n  if (__pxlblz_show_elapsed_ms >= 10000) __pxlblz_show_route_layout = 2\n  if (__pxlblz_show_elapsed_ms >= 15000) __pxlblz_show_route_layout = 3\n  if (__pxlblz_show_elapsed_ms >= 20000) __pxlblz_show_route_layout = 0\n  if (__pxlblz_show_route_layout == 0) {\n    __pxlblz_show_c0_pixelCount = pixelCount\n  }\n  else if (__pxlblz_show_route_layout == 1) {\n    __pxlblz_show_c0_pixelCount = max(1, floor(pixelCount / 4))\n  }\n  else if (__pxlblz_show_route_layout == 2) {\n    __pxlblz_show_c0_pixelCount = max(1, floor(pixelCount / 4))\n  }\n  else if (__pxlblz_show_route_layout == 3) {\n    __pxlblz_show_c0_pixelCount = max(1, floor(pixelCount / 4))\n  }\n  __pxlblz_show_c0_advance(delta)\n}\n\nexport function render2D(index, x, y) {\n  if (__pxlblz_show_route_layout == 0) {\n    var __pxlblz_show_route_id = 0\n    var __pxlblz_show_route_local_x = clamp(x, 0, 1)\n    var __pxlblz_show_route_local_y = clamp(y, 0, 1)\n    if (__pxlblz_show_route_id == 0) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n  }\n  else if (__pxlblz_show_route_layout == 1) {\n    var __pxlblz_show_route_column = min(1, floor(clamp(x, 0, 1) * 2))\n    var __pxlblz_show_route_row = min(1, floor(clamp(y, 0, 1) * 2))\n    var __pxlblz_show_route_id = __pxlblz_show_route_row * 2 + __pxlblz_show_route_column\n    var __pxlblz_show_route_local_x = clamp(x * 2 - __pxlblz_show_route_column, 0, 1)\n    var __pxlblz_show_route_local_y = clamp(y * 2 - __pxlblz_show_route_row, 0, 1)\n    if (__pxlblz_show_route_id == 0) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 1) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 2) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 3) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n  }\n  else if (__pxlblz_show_route_layout == 2) {\n    var __pxlblz_show_route_id = min(3, floor(clamp(x, 0, 1) * 4))\n    var __pxlblz_show_route_stripe_local = clamp(x * 4 - __pxlblz_show_route_id, 0, 1)\n    var __pxlblz_show_route_local_x = __pxlblz_show_route_stripe_local\n    var __pxlblz_show_route_local_y = clamp(y, 0, 1)\n    if (__pxlblz_show_route_id == 0) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 1) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 2) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 3) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n  }\n  else if (__pxlblz_show_route_layout == 3) {\n    var __pxlblz_show_route_dx = clamp(x, 0, 1) - 0.5\n    var __pxlblz_show_route_dy = clamp(y, 0, 1) - 0.5\n    var __pxlblz_show_route_radius = hypot(__pxlblz_show_route_dx, __pxlblz_show_route_dy)\n    var __pxlblz_show_route_turn = frac((atan2(__pxlblz_show_route_dy, __pxlblz_show_route_dx) + __pxlblz_show_route_radius * 4.241150082346221) / 6.283185307179586 + 1)\n    var __pxlblz_show_route_id = min(3, floor(__pxlblz_show_route_turn * 4))\n    var __pxlblz_show_route_local_x = clamp(__pxlblz_show_route_turn * 4 - __pxlblz_show_route_id, 0, 1)\n    var __pxlblz_show_route_local_y = clamp(__pxlblz_show_route_radius / 0.7071067811865476, 0, 1)\n    if (__pxlblz_show_route_id == 0) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 1) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 2) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n    else if (__pxlblz_show_route_id == 3) {\n      var __pxlblz_show_route_side = ceil(sqrt(__pxlblz_show_c0_pixelCount))\n      var __pxlblz_show_route_local_index = min(__pxlblz_show_c0_pixelCount - 1, floor(__pxlblz_show_route_local_y * __pxlblz_show_route_side) * __pxlblz_show_route_side + floor(__pxlblz_show_route_local_x * __pxlblz_show_route_side))\n      __pxlblz_show_c0_renderCapture2D(__pxlblz_show_route_local_index, __pxlblz_show_route_local_x, __pxlblz_show_route_local_y)\n      __pxlblz_show_c0_emit()\n      return\n    }\n  }\n  rgb(0, 0, 0)\n}\n\n"
  },
  "preview": ""
}